fn square(x: i32) -> i32 {
    return x * x;
}

fn main() {
    let mut total: i32 = 0;
    let mut i: i32 = 1;
    while i <= 4 {
        let mut j: i32 = 1;
        while j <= i {
            total = total + square(j);
            j = j + 1;
        }
        i = i + 1;
    }
    assert(total == 50);
    return;
}
