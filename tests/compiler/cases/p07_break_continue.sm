fn sum_odd_until(limit: i32, stop: i32) -> i32 {
    let mut i: i32 = 0;
    let mut s: i32 = 0;
    while i < limit {
        i = i + 1;
        if i % 2 == 0 {
            continue;
        }
        if i > stop {
            break;
        }
        s = s + i;
    }
    return s;
}

fn main() {
    assert(sum_odd_until(100, 9) == 25);
    assert(sum_odd_until(6, 100) == 9);
    return;
}
