fn sum_to(n: u32) -> u32 {
    let mut s: u32 = 0u32;
    let mut i: u32 = 1u32;
    while i <= n {
        s = s + i;
        i = i + 1u32;
    }
    return s;
}

fn main() {
    assert(sum_to(10u32) == 55u32);
    assert(4294967295u32 > 2147483647u32);
    assert(7u32 / 2u32 == 3u32 && 7u32 % 2u32 == 1u32);
    return;
}
