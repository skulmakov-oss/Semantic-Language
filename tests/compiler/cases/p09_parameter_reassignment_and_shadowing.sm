fn countdown(n: i32) -> i32 {
    let mut steps: i32 = 0;
    while n > 0 {
        n = n - 1;
        steps = steps + 1;
    }
    let steps: i32 = steps * 10;
    return steps;
}

fn main() {
    assert(countdown(4) == 40);
    let x: i32 = 1;
    if x == 1 {
        let x: i32 = 2;
        assert(x == 2);
    }
    assert(x == 1);
    return;
}
