fn classify(n: i32) -> i32 {
    let mut r: i32 = 0;
    if n % 15 == 0 {
        r = 3;
    } else if n % 5 == 0 {
        r = 2;
    } else if n % 3 == 0 {
        r = 1;
    } else {
        r = 0;
    }
    return r;
}

fn main() {
    assert(classify(30) == 3);
    assert(classify(10) == 2);
    assert(classify(9) == 1);
    assert(classify(7) == 0);
    return;
}
