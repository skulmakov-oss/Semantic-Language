fn insert(xs: Sequence(i32), v: i32) -> Sequence(i32) {
    let mut out: Sequence(i32) = [];
    let mut placed: bool = false;
    for x in xs {
        if !placed && v < x {
            out = push(out, v);
            placed = true;
        }
        out = push(out, x);
    }
    if !placed {
        out = push(out, v);
    }
    return out;
}

fn main() {
    let mut xs: Sequence(i32) = [];
    let mut seed: i32 = 17;
    let mut i: i32 = 0;
    while i < 60 {
        seed = (seed * 73 + 41) % 1009;
        xs = insert(xs, seed);
        i = i + 1;
    }
    let mut line: text = "";
    let mut k: i32 = 0;
    while k < 60 {
        line = line + to_text(xs[k]) + " ";
        k = k + 10;
    }
    print(line + to_text(len(xs)));
    return;
}
