fn is_even(n: i32) -> bool {
    if n == 0 {
        return true;
    }
    return is_odd(n - 1);
}

fn is_odd(n: i32) -> bool {
    if n == 0 {
        return false;
    }
    return is_even(n - 1);
}

fn main() {
    print(to_text(is_even(10)) + " " + to_text(is_odd(7)) + " " + to_text(is_even(99)));
    return;
}
