fn main() {
    let a: u32 = 4000000000u32;
    let b: u32 = 294967295u32;
    print(to_text(a + b) + " " + to_text(a - b) + " " + to_text(65536u32 * 65535u32) + " " + to_text(a / 7u32) + " " + to_text(a % 7u32));
    print(to_text(b < a) + " " + to_text(a <= a) + " " + to_text(a == 4000000000u32));
    return;
}
