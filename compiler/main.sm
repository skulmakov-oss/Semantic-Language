// Compiler entry point (application profile cli-read-only).
// R1 supports only direct local bare imports: Import "helper.sm".
Import "driver.sm"

record Load {
    src: text,
    seen: Sequence(text),
    err: text,
    files: Sequence(SourceFile),
    spans: Sequence(SourceSpan),
}

// Source text is reconstructed byte-for-byte by the existing loader;
// these helpers only describe where each copied segment came from.
fn append_source_span(spans: Sequence(SourceSpan), path: text, local: u32, flat: u32, count: u32) -> Sequence(SourceSpan) {
    if count == 0u32 { return spans; }
    return push(spans, SourceSpan { path: path, local_start: local, flat_start: flat, size: count });
}

fn append_child_spans(spans0: Sequence(SourceSpan), child: Load, start: u32) -> Sequence(SourceSpan) {
    let mut spans: Sequence(SourceSpan) = spans0;
    for part in child.spans {
        spans = push(spans, part with { flat_start: part.flat_start + start });
    }
    return spans;
}


fn normalize_import_path(path: text) -> text {
    let mut value: text = path;
    let mut changed: bool = true;
    while changed {
        changed = false;
        if text_len(value) >= 2u32 {
            let prefix: text = match text_slice(value, 0u32, 2u32) {
                Option::Some(x) => { x }
                Option::None => { "" }
            };
            if prefix == "./" {
                value = match text_slice(value, 2u32, text_len(value)) {
                    Option::Some(x) => { x }
                    Option::None => { "" }
                };
                changed = true;
            }
        }
    }
    return value;
}

fn dirname(path: text) -> text {
    let n: u32 = text_len(path);
    let mut i: u32 = n;
    while i > 0u32 {
        i = i - 1u32;
        let b: u32 = match text_byte_at(path, i) {
            Option::Some(x) => { x }
            Option::None => { 0u32 }
        };
        if b == 47u32 || b == 92u32 {
            return match text_slice(path, 0u32, i + 1u32) {
                Option::Some(d) => { d }
                Option::None => { "" }
            };
        }
    }
    return "";
}

fn expand(path: text, stack: Sequence(text), seen0: Sequence(text)) -> Load {
    let mut si: i32 = 0;
    while si < len(stack) {
        if stack[si] == path {
            return Load { src: "", seen: seen0, err: "cyclic executable helper import detected: " + path, files: [], spans: [] };
        }
        si = si + 1;
    }
    si = 0;
    while si < len(seen0) {
        if seen0[si] == path {
            return Load { src: "", seen: seen0, err: "duplicate executable helper import: " + path, files: [], spans: [] };
        }
        si = si + 1;
    }

    let mut seen: Sequence(text) = push(seen0, path);
    let src: text = fs_read_text(path);
    let n: u32 = text_len(src);
    let mut files: Sequence(SourceFile) = [SourceFile { path: path, content: src }];
    let mut spans: Sequence(SourceSpan) = [];
    let mut out: text = "";
    let mut imported: bool = false;
    let mut pos: u32 = 0u32;
    let mut chunk_start: u32 = 0u32;
    let mut has_chunk: bool = false;
    while pos < n {
        let mut k: u32 = pos;
        while k < n {
            let kb: u32 = match text_byte_at(src, k) {
                Option::Some(x) => { x }
                Option::None => { 10u32 }
            };
            if kb == 10u32 || kb > 32u32 { break; }
            if kb != 32u32 && kb != 9u32 && kb != 13u32 { break; }
            k = k + 1u32;
        }
        let kb0: u32 = match text_byte_at(src, k) {
            Option::Some(x) => { x }
            Option::None => { 10u32 }
        };
        if kb0 == 10u32 || k >= n {
            if k < n { pos = k + 1u32; } else { pos = n; }
        } else if kb0 == 47u32 {
            if !has_chunk {
                chunk_start = pos;
                has_chunk = true;
            }
            let mut end: u32 = k + 1u32;
            while end < n {
                let eb: u32 = match text_byte_at(src, end) {
                    Option::Some(x) => { x }
                    Option::None => { 10u32 }
                };
                if eb == 10u32 { break; }
                end = end + 1u32;
            }
            if end < n { pos = end + 1u32; } else { pos = n; }
        } else {
            let mut end: u32 = k + 1u32;
            let mut is_import: bool = false;
            if kb0 == 73u32 {
                while end < n {
                    let eb: u32 = match text_byte_at(src, end) {
                        Option::Some(x) => { x }
                        Option::None => { 10u32 }
                    };
                    if eb == 10u32 { break; }
                    end = end + 1u32;
                }
                if k + 7u32 <= end {
                    let prefix: text = match text_slice(src, k, k + 7u32) {
                        Option::Some(x) => { x }
                        Option::None => { "" }
                    };
                    if prefix == "Import " { is_import = true; }
                }
            }
            if is_import {
                if has_chunk {
                    let seg: text = match text_slice(src, chunk_start, pos) {
                        Option::Some(s) => { s }
                        Option::None => { "" }
                    };
                    if text_len(out) == 0u32 {
                        spans = append_source_span(spans, path, chunk_start, 0u32, text_len(seg));
                        out = seg;
                    } else {
                        let lb: u32 = match text_byte_at(out, text_len(out) - 1u32) {
                            Option::Some(x) => { x }
                            Option::None => { 0u32 }
                        };
                        if lb == 10u32 {
                            spans = append_source_span(spans, path, chunk_start, text_len(out), text_len(seg));
                            out = out + seg;
                        } else {
                            spans = append_source_span(spans, "", 0u32, text_len(out), 1u32);
                            spans = append_source_span(spans, path, chunk_start, text_len(out) + 1u32, text_len(seg));
                            out = out + "\n" + seg;
                        }
                    }
                    has_chunk = false;
                }
                imported = true;
                let qopen: u32 = match text_byte_at(src, k + 7u32) {
                    Option::Some(x) => { x }
                    Option::None => { 0u32 }
                };
                if k + 8u32 >= end || qopen != 34u32 {
                    return Load { src: "", seen: seen, err: "unsupported import form", files: [], spans: [] };
                }
                let mut q: u32 = k + 8u32;
                while q < end {
                    let qb: u32 = match text_byte_at(src, q) {
                        Option::Some(x) => { x }
                        Option::None => { 0u32 }
                    };
                    if qb == 34u32 { break; }
                    q = q + 1u32;
                }
                if q >= end {
                    return Load { src: "", seen: seen, err: "malformed import path", files: [], spans: [] };
                }
                let raw_rel: text = match text_slice(src, k + 8u32, q) {
                    Option::Some(x) => { x }
                    Option::None => { "" }
                };
                let rel: text = normalize_import_path(raw_rel);
                let mut tail: u32 = q + 1u32;
                while tail < end {
                    let tb: u32 = match text_byte_at(src, tail) {
                        Option::Some(x) => { x }
                        Option::None => { 0u32 }
                    };
                    if tb != 32u32 && tb != 9u32 && tb != 13u32 { break; }
                    tail = tail + 1u32;
                }
                if tail < end || text_len(rel) == 0u32 {
                    return Load { src: "", seen: seen, err: "unsupported import form", files: [], spans: [] };
                }
                let rlen: u32 = text_len(rel);
                let mut bad_rel: bool = false;
                if rlen > 1u32 {
                    let b1: u32 = match text_byte_at(rel, 1u32) {
                        Option::Some(x) => { x }
                        Option::None => { 0u32 }
                    };
                    if b1 == 58u32 { bad_rel = true; }
                }
                let mut ri: u32 = 0u32;
                while ri < rlen {
                    let rb: u32 = match text_byte_at(rel, ri) {
                        Option::Some(x) => { x }
                        Option::None => { 0u32 }
                    };
                    if rb == 47u32 || rb == 92u32 { bad_rel = true; }
                    if rb == 46u32 && ri + 1u32 < rlen {
                        let rb2: u32 = match text_byte_at(rel, ri + 1u32) {
                            Option::Some(x) => { x }
                            Option::None => { 0u32 }
                        };
                        if rb2 == 46u32 { bad_rel = true; }
                    }
                    ri = ri + 1u32;
                }
                if bad_rel {
                    return Load { src: "", seen: seen, err: "import path escapes the declared source root", files: [], spans: [] };
                }
                let child: text = dirname(path) + rel;
                let child_load: Load = expand(child, push(stack, path), seen);
                if child_load.err != "" { return child_load; }
                let separator: text = if end < n {
                    match text_slice(src, end, end + 1u32) {
                        Option::Some(eol) => { eol }
                        Option::None => { "" }
                    }
                } else { "" };
                if text_len(out) == 0u32 {
                    spans = append_child_spans(spans, child_load, 0u32);
                    out = child_load.src;
                } else {
                    let last_b: u32 = match text_byte_at(out, text_len(out) - 1u32) {
                        Option::Some(x) => { x }
                        Option::None => { 0u32 }
                    };
                    if last_b == 10u32 {
                        spans = append_child_spans(spans, child_load, text_len(out));
                        out = out + child_load.src;
                    } else {
                        spans = append_source_span(spans, "", 0u32, text_len(out), text_len(separator));
                        spans = append_child_spans(spans, child_load, text_len(out) + text_len(separator));
                        out = out + separator + child_load.src;
                    }
                }
                if end < n && text_len(out) > 0u32 {
                    let last_b2: u32 = match text_byte_at(out, text_len(out) - 1u32) {
                        Option::Some(x) => { x }
                        Option::None => { 0u32 }
                    };
                    if last_b2 != 10u32 {
                        spans = append_source_span(spans, "", 0u32, text_len(out), text_len(separator));
                        out = out + separator;
                    }
                }
                for file in child_load.files { files = push(files, file); }
                seen = child_load.seen;
                if end < n { pos = end + 1u32; } else { pos = n; }
            } else {
                if !imported { return Load { src: src, seen: seen, err: "", files: files,
                    spans: append_source_span([], path, 0u32, 0u32, n) }; }
                if !has_chunk {
                    chunk_start = pos;
                    has_chunk = true;
                }
                pos = n;
            }
        }
    }
    if !imported { return Load { src: src, seen: seen, err: "", files: files,
                    spans: append_source_span([], path, 0u32, 0u32, n) }; }
    if has_chunk {
        let seg: text = match text_slice(src, chunk_start, n) {
            Option::Some(s) => { s }
            Option::None => { "" }
        };
        if text_len(out) == 0u32 {
            spans = append_source_span(spans, path, chunk_start, 0u32, text_len(seg));
            out = seg;
        } else {
            let lb: u32 = match text_byte_at(out, text_len(out) - 1u32) {
                Option::Some(x) => { x }
                Option::None => { 0u32 }
            };
            if lb == 10u32 {
                spans = append_source_span(spans, path, chunk_start, text_len(out), text_len(seg));
                out = out + seg;
            } else {
                spans = append_source_span(spans, "", 0u32, text_len(out), 1u32);
                spans = append_source_span(spans, path, chunk_start, text_len(out) + 1u32, text_len(seg));
                out = out + "\n" + seg;
            }
        }
    }
    return Load { src: out, seen: seen, err: "", files: files, spans: spans };
}

fn main() {
    let loaded: Load = expand(args_read(0u32), [], []);
    if loaded.err != "" {
        stdout_write("error unsupported @0: " + loaded.err);
        return;
    }
    stdout_write(compile_source_with_origins(loaded.src, loaded.files, loaded.spans));
    return;
}
