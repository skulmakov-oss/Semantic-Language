// Compiler entry point (application profile cli-read-only).
// R1 supports only direct local bare imports: Import "helper.sm".
Import "driver.sm"

record Load {
    text: text,
    seen: Sequence(text),
    err: text
}

fn line_end(src: text, start: u32) -> u32 {
    let n: u32 = text_len(src);
    let mut i: u32 = start;
    while i < n {
        if text_byte_at(src, i) == Option::Some(10u32) { return i; }
        i = i + 1u32;
    }
    return n;
}

fn skip_spaces(src: text, start: u32, end: u32) -> u32 {
    let mut i: u32 = start;
    while i < end {
        let b: Option(u32) = text_byte_at(src, i);
        if b != Option::Some(32u32) && b != Option::Some(9u32) && b != Option::Some(13u32) { return i; }
        i = i + 1u32;
    }
    return i;
}

fn normalize_import_path(path: text) -> text {
    let mut value: text = path;
    let mut changed: bool = true;
    while changed {
        changed = false;
        if text_len(value) >= 2u32 {
            let prefix: text = match text_slice(value, 0u32, 2u32) {
                Option::Some(x) => { x }
                Option::None => { "" }
            };
            if prefix == "./" {
                value = match text_slice(value, 2u32, text_len(value)) {
                    Option::Some(x) => { x }
                    Option::None => { "" }
                };
                changed = true;
            }
        }
    }
    return value;
}

fn has_path_separator(path: text) -> bool {
    let n: u32 = text_len(path);
    let mut i: u32 = 0u32;
    while i < n {
        let b: Option(u32) = text_byte_at(path, i);
        if b == Option::Some(47u32) || b == Option::Some(92u32) { return true; }
        i = i + 1u32;
    }
    return false;
}

fn append_module(dst: text, src: text, separator: text) -> text {
    if text_len(dst) == 0u32 { return src; }
    if text_byte_at(dst, text_len(dst) - 1u32) == Option::Some(10u32) {
        return dst + src;
    }
    return dst + separator + src;
}

fn has_dotdot(src: text) -> bool {
    let n: u32 = text_len(src);
    let mut i: u32 = 0u32;
    while i + 1u32 < n {
        if text_byte_at(src, i) == Option::Some(46u32) && text_byte_at(src, i + 1u32) == Option::Some(46u32) { return true; }
        i = i + 1u32;
    }
    return false;
}

fn dirname(path: text) -> text {
    let n: u32 = text_len(path);
    let mut i: u32 = n;
    while i > 0u32 {
        i = i - 1u32;
        let b: Option(u32) = text_byte_at(path, i);
        if b == Option::Some(47u32) || b == Option::Some(92u32) {
            return match text_slice(path, 0u32, i + 1u32) {
                Option::Some(d) => { d }
                Option::None => { "" }
            };
        }
    }
    return "";
}

fn contains_path(paths: Sequence(text), path: text) -> bool {
    let mut i: i32 = 0;
    while i < len(paths) {
        if paths[i] == path { return true; }
        i = i + 1;
    }
    return false;
}

fn has_import_marker(src: text) -> bool {
    let n: u32 = text_len(src);
    let mut i: u32 = 0u32;
    while i + 7u32 <= n {
        if text_byte_at(src, i) == Option::Some(73u32)
            && text_byte_at(src, i + 1u32) == Option::Some(109u32)
            && text_byte_at(src, i + 2u32) == Option::Some(112u32)
            && text_byte_at(src, i + 3u32) == Option::Some(111u32)
            && text_byte_at(src, i + 4u32) == Option::Some(114u32)
            && text_byte_at(src, i + 5u32) == Option::Some(116u32)
            && text_byte_at(src, i + 6u32) == Option::Some(32u32) {
            return true;
        }
        i = i + 1u32;
    }
    return false;
}

fn append_line(dst: text, src: text, start: u32, end: u32) -> text {
    let line: text = if end > start && text_byte_at(src, end - 1u32) == Option::Some(13u32) {
        match text_slice(src, start, end - 1u32) {
            Option::Some(body) => {
                if end < text_len(src) {
                    match text_slice(src, end, end + 1u32) {
                        Option::Some(eol) => { body + eol }
                        Option::None => { body }
                    }
                } else { body }
            }
            Option::None => { "" }
        }
    } else {
        match text_slice(src, start, end) {
            Option::Some(body) => {
                if end < text_len(src) {
                    match text_slice(src, end, end + 1u32) {
                        Option::Some(eol) => { body + eol }
                        Option::None => { body }
                    }
                } else { body }
            }
            Option::None => { "" }
        }
    };
    let separator: text = if end < text_len(src) {
        match text_slice(src, end, end + 1u32) {
            Option::Some(eol) => { eol }
            Option::None => { "" }
        }
    } else { "" };
    return append_module(dst, line, separator);
}

fn expand(path: text, stack: Sequence(text), seen0: Sequence(text)) -> Load {
    if contains_path(stack, path) {
        return Load { text: "", seen: seen0, err: "cyclic executable helper import detected: " + path };
    }
    if contains_path(seen0, path) {
        return Load { text: "", seen: seen0, err: "duplicate executable helper import: " + path };
    }

    let seen: Sequence(text) = push(seen0, path);
    let src: text = fs_read_text(path);
    let n: u32 = text_len(src);
    let mut out: text = "";
    let mut imported: bool = false;
    let mut pos: u32 = 0u32;
    while pos < n {
        let end: u32 = line_end(src, pos);
        let k: u32 = skip_spaces(src, pos, end);
        let prefix: text = match text_slice(src, k, k + 7u32) {
            Option::Some(x) => { x }
            Option::None => { "" }
        };
        if prefix == "Import " {
            imported = true;
            if k + 8u32 >= end || text_byte_at(src, k + 7u32) != Option::Some(34u32) {
                return Load { text: "", seen: seen, err: "unsupported import form" };
            }
            let mut q: u32 = k + 8u32;
            while q < end && text_byte_at(src, q) != Option::Some(34u32) { q = q + 1u32; }
            if q >= end {
                return Load { text: "", seen: seen, err: "malformed import path" };
            }
            let raw_rel: text = match text_slice(src, k + 8u32, q) {
                Option::Some(x) => { x }
                Option::None => { "" }
            };
            let rel: text = normalize_import_path(raw_rel);
            let tail: u32 = skip_spaces(src, q + 1u32, end);
            if tail < end || text_len(rel) == 0u32 {
                return Load { text: "", seen: seen, err: "unsupported import form" };
            }
            if has_path_separator(rel) || has_dotdot(rel) || (text_len(rel) > 1u32 && text_byte_at(rel, 1u32) == Option::Some(58u32)) {
                return Load { text: "", seen: seen, err: "import path escapes the declared source root" };
            }
            let child: text = dirname(path) + rel;
            let child_load: Load = expand(child, push(stack, path), seen);
            if child_load.err != "" { return child_load; }
            let separator: text = if end < n {
                match text_slice(src, end, end + 1u32) {
                    Option::Some(eol) => { eol }
                    Option::None => { "" }
                }
            } else { "" };
            out = append_module(out, child_load.text, separator);
            if end < n && text_len(out) > 0u32 && text_byte_at(out, text_len(out) - 1u32) != Option::Some(10u32) {
                out = out + separator;
            }
            seen = child_load.seen;
        } else if k != end {
            out = append_line(out, src, pos, end);
        }
        if end < n { pos = end + 1u32; } else { pos = n; }
    }
    if !imported { return Load { text: src, seen: seen, err: "" }; }
    return Load { text: out, seen: seen, err: "" };
}

fn main() {
    let path: text = args_read(0u32);
    let source: text = fs_read_text(path);
    if !has_import_marker(source) {
        stdout_write(compile_source(source));
        return;
    }
    let loaded: Load = expand(path, [], []);
    if loaded.err != "" {
        stdout_write("error unsupported @0: " + loaded.err);
        return;
    }
    stdout_write(compile_source(loaded.text));
    return;
}
