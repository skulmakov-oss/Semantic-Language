// lexer: UTF-8 source bytes -> token sequence.
record Tok {
    kind: i32,
    word: text,
    num: i32,
    pos: u32,
}

record Lexed {
    toks: Sequence(Tok),
    err: text,
    cat: text,
    errpos: u32,
}

fn lex(src: text) -> Lexed {
    let n: u32 = text_len(src);
    let mut toks: Sequence(Tok) = [];
    let mut i: u32 = 0u32;
    let limit: text = "4294967295";
    let mut b: u32 = match text_byte_at(src, 0u32) {
        Option::Some(x) => { x }
        Option::None => { 0u32 }
    };
    while i < n {
        if b <= 32u32 {
            while true {
                if b != 32u32 {
                    if b != 10u32 {
                        if b > 13u32 { break; }
                        if b != 13u32 {
                            if b != 9u32 { break; }
                        }
                    }
                }
                i = i + 1u32;
                b = match text_byte_at(src, i) {
                    Option::Some(x) => { x }
                    Option::None => { 256u32 }
                };
            }
            if i >= n { break; }
        }
        if b >= 65u32 {
            let mut is_ident: bool = false;
            if b >= 97u32 {
                if b <= 122u32 { is_ident = true; }
            } else if b <= 90u32 {
                is_ident = true;
            } else if b == 95u32 {
                is_ident = true;
            }
            if is_ident {
                let start: u32 = i;
                let b0: u32 = b;
                i = i + 1u32;
                while true {
                    b = match text_byte_at(src, i) {
                        Option::Some(x) => { x }
                        Option::None => { 0u32 }
                    };
                    if b >= 97u32 {
                        if b > 122u32 { break; }
                    } else if b >= 48u32 {
                        if b > 57u32 {
                            if b != 95u32 {
                                if b < 65u32 { break; }
                                if b > 90u32 { break; }
                            }
                        }
                    } else {
                        break;
                    }
                    i = i + 1u32;
                }
                let w: text = match text_slice(src, start, i) {
                    Option::Some(s) => { s }
                    Option::None => { "" }
                };
                let wlen: u32 = i - start;
                let mut k: i32 = 2;
                if wlen >= 2u32 {
                    if wlen <= 6u32 {
                        if wlen == 2u32 {
                            if b0 == 105u32 {
                                if w == "if" { k = 12; }
                                else if w == "in" { k = 56; }
                            } else if b0 == 102u32 {
                                if w == "fn" { k = 5; }
                            }
                        } else if wlen == 3u32 {
                            if b0 == 108u32 { if w == "let" { k = 3; } }
                            else if b0 == 109u32 { if w == "mut" { k = 4; } }
                            else if b0 == 105u32 { if w == "i32" { k = 10; } }
                            else if b0 == 117u32 { if w == "u32" { k = 54; } }
                            else if b0 == 102u32 { if w == "for" { k = 19; } }
                        } else if wlen == 4u32 {
                            if b0 == 101u32 { if w == "else" { k = 13; } }
                            else if b0 == 116u32 {
                                if w == "true" { k = 8; }
                                else if w == "text" { k = 55; }
                            } else if b0 == 98u32 { if w == "bool" { k = 11; } }
                            else if b0 == 119u32 { if w == "with" { k = 53; } }
                            else if b0 == 108u32 { if w == "loop" { k = 18; } }
                        } else if wlen == 5u32 {
                            if b0 == 119u32 { if w == "while" { k = 14; } }
                            else if b0 == 109u32 { if w == "match" { k = 52; } }
                            else if b0 == 102u32 { if w == "false" { k = 9; } }
                            else if b0 == 98u32 { if w == "break" { k = 16; } }
                            else if b0 == 99u32 { if w == "const" { k = 15; } }
                        } else {
                            if b0 == 114u32 {
                                if w == "return" { k = 7; }
                                else if w == "record" { k = 51; }
                            } else if b0 == 97u32 { if w == "assert" { k = 6; } }
                        }
                    } else if wlen == 8u32 {
                        if b0 == 99u32 { if w == "continue" { k = 17; } }
                    }
                }
                toks = push(toks, Tok { kind: k, word: w, num: 0, pos: start });
            } else if b == 123u32 {
                toks = push(toks, Tok { kind: 22, word: "{", num: 0, pos: i });
                i = i + 1u32;
                b = match text_byte_at(src, i) { Option::Some(x) => { x } Option::None => { 0u32 } };
            } else if b == 125u32 {
                toks = push(toks, Tok { kind: 23, word: "}", num: 0, pos: i });
                i = i + 1u32;
                b = match text_byte_at(src, i) { Option::Some(x) => { x } Option::None => { 0u32 } };
            } else if b == 91u32 {
                toks = push(toks, Tok { kind: 47, word: "[", num: 0, pos: i });
                i = i + 1u32;
                b = match text_byte_at(src, i) { Option::Some(x) => { x } Option::None => { 0u32 } };
            } else if b == 93u32 {
                toks = push(toks, Tok { kind: 48, word: "]", num: 0, pos: i });
                i = i + 1u32;
                b = match text_byte_at(src, i) { Option::Some(x) => { x } Option::None => { 0u32 } };
            } else if b == 124u32 {
                let nx: u32 = match text_byte_at(src, i + 1u32) { Option::Some(x) => { x } Option::None => { 0u32 } };
                if nx == 124u32 {
                    toks = push(toks, Tok { kind: 42, word: "||", num: 0, pos: i });
                    i = i + 2u32;
                    b = match text_byte_at(src, i) { Option::Some(x) => { x } Option::None => { 0u32 } };
                } else {
                    return Lexed { toks: toks, err: "'|' is outside the supported subset", cat: "unsupported", errpos: i };
                }
            } else {
                return Lexed { toks: toks, err: "unexpected character", cat: "syntax", errpos: i };
            }
        } else if b >= 48u32 {
            if b <= 57u32 {
                let start: u32 = i;
                let mut v: i32 = 0;
                let mut digits: i32 = 0;
                let mut over_i32: bool = false;
                let mut cmp: i32 = 0;
                let mut li: u32 = 0u32;
                while b >= 48u32 {
                    if b > 57u32 { break; }
                    let d: i32 = if b < 53u32 {
                        if b < 50u32 { if b == 48u32 { 0 } else { 1 } }
                        else { if b == 50u32 { 2 } else if b == 51u32 { 3 } else { 4 } }
                    } else {
                        if b < 55u32 { if b == 53u32 { 5 } else { 6 } }
                        else { if b == 55u32 { 7 } else if b == 56u32 { 8 } else { 9 } }
                    };
                    if v > 214748364 { over_i32 = true; }
                    else if v == 214748364 { if d > 7 { over_i32 = true; } }
                    else if v < 0 { over_i32 = true; }
                    if d != 0 || digits > 0 {
                        if digits < 10 {
                            if cmp == 0 {
                                let ld: u32 = match text_byte_at(limit, li) {
                                    Option::Some(x) => { x }
                                    Option::None => { 48u32 }
                                };
                                if b < ld { cmp = 0 - 1; }
                                if b > ld { cmp = 1; }
                            }
                        }
                        digits = digits + 1;
                        li = li + 1u32;
                    }
                    v = v * 10 + d;
                    i = i + 1u32;
                    b = match text_byte_at(src, i) {
                        Option::Some(x) => { x }
                        Option::None => { 0u32 }
                    };
                }
                let mut kind: i32 = 1;
                if b == 117u32 || b == 105u32 {
                    let suffix: text = match text_slice(src, i, i + 3u32) {
                        Option::Some(s) => { s }
                        Option::None => { "" }
                    };
                    if suffix == "u32" {
                        kind = 45;
                        i = i + 3u32;
                    } else if suffix == "i32" {
                        i = i + 3u32;
                    }
                    b = match text_byte_at(src, i) {
                        Option::Some(x) => { x }
                        Option::None => { 0u32 }
                    };
                }
                if b >= 65u32 {
                    if b <= 90u32 || b == 95u32 || (b >= 97u32 && b <= 122u32) {
                        return Lexed { toks: toks, err: "malformed or unsupported numeric literal", cat: "unsupported", errpos: start };
                    }
                }
                if kind == 1 {
                    if over_i32 {
                        return Lexed { toks: toks, err: "integer literal out of i32 range", cat: "syntax", errpos: start };
                    }
                } else {
                    if digits > 10 || (digits == 10 && cmp > 0) {
                        return Lexed { toks: toks, err: "integer literal out of u32 range", cat: "syntax", errpos: start };
                    }
                }
                let w: text = match text_slice(src, start, i) {
                    Option::Some(s) => { s }
                    Option::None => { "" }
                };
                toks = push(toks, Tok { kind: kind, word: w, num: v, pos: start });
            } else if b == 59u32 {
                toks = push(toks, Tok { kind: 24, word: ";", num: 0, pos: i });
                i = i + 1u32;
                b = match text_byte_at(src, i) { Option::Some(x) => { x } Option::None => { 0u32 } };
            } else {
                let nx: u32 = match text_byte_at(src, i + 1u32) {
                    Option::Some(x) => { x }
                    Option::None => { 0u32 }
                };
                let mut k: i32 = 0;
                let mut w: text = "";
                let mut width: u32 = 1u32;
                if b == 58u32 {
                    if nx == 58u32 { k = 49; width = 2u32; w = "::"; } else { k = 25; w = ":"; }
                } else if b == 61u32 {
                    if nx == 61u32 { k = 35; width = 2u32; w = "=="; }
                    else if nx == 62u32 { k = 50; width = 2u32; w = "=>"; }
                    else { k = 26; w = "="; }
                } else if b == 60u32 {
                    if nx == 61u32 { k = 38; width = 2u32; w = "<="; } else { k = 37; w = "<"; }
                } else if b == 62u32 {
                    if nx == 61u32 { k = 40; width = 2u32; w = ">="; } else { k = 39; w = ">"; }
                } else if b == 63u32 {
                    return Lexed { toks: toks, err: "'?' is outside the supported subset", cat: "unsupported", errpos: i };
                } else {
                    return Lexed { toks: toks, err: "unexpected character", cat: "syntax", errpos: i };
                }
                toks = push(toks, Tok { kind: k, word: w, num: 0, pos: i });
                if width == 2u32 {
                    i = i + 2u32;
                    b = match text_byte_at(src, i) { Option::Some(x) => { x } Option::None => { 0u32 } };
                } else {
                    i = i + 1u32;
                    b = nx;
                }
            }
        } else if b == 34u32 {
            let start: u32 = i;
            i = i + 1u32;
            let mut c: u32 = 0u32;
            while true {
                c = match text_byte_at(src, i) {
                    Option::Some(x) => { x }
                    Option::None => { 10u32 }
                };
                if c == 34u32 { break; }
                if c == 10u32 { break; }
                i = i + 1u32;
            }
            if c != 34u32 {
                return Lexed { toks: toks, err: "unterminated text literal", cat: "syntax", errpos: start };
            }
            i = i + 1u32;
            let w: text = match text_slice(src, start, i) {
                Option::Some(s) => { s }
                Option::None => { "" }
            };
            toks = push(toks, Tok { kind: 44, word: w, num: 0, pos: start });
            b = match text_byte_at(src, i) {
                Option::Some(x) => { x }
                Option::None => { 0u32 }
            };
        } else if b == 47u32 {
            let nx: u32 = match text_byte_at(src, i + 1u32) {
                Option::Some(x) => { x }
                Option::None => { 0u32 }
            };
            if nx == 47u32 {
                i = i + 2u32;
                while true {
                    let c: u32 = match text_byte_at(src, i) {
                        Option::Some(x) => { x }
                        Option::None => { 10u32 }
                    };
                    i = i + 1u32;
                    if c == 10u32 { break; }
                }
                b = match text_byte_at(src, i) {
                    Option::Some(x) => { x }
                    Option::None => { 0u32 }
                };
            } else {
                toks = push(toks, Tok { kind: 33, word: "/", num: 0, pos: i });
                i = i + 1u32;
                b = nx;
            }
        } else {
            let mut k: i32 = 0;
            let mut w: text = "";
            if b == 40u32 { k = 20; w = "("; }
            else if b == 41u32 { k = 21; w = ")"; }
            else if b == 44u32 { k = 27; w = ","; }
            else if b == 46u32 { k = 46; w = "."; }
            else if b == 43u32 { k = 30; w = "+"; }
            else if b == 42u32 { k = 32; w = "*"; }
            else if b == 37u32 { k = 34; w = "%"; }
            if k != 0 {
                toks = push(toks, Tok { kind: k, word: w, num: 0, pos: i });
                i = i + 1u32;
                b = match text_byte_at(src, i) {
                    Option::Some(x) => { x }
                    Option::None => { 0u32 }
                };
            } else {
                let nx: u32 = match text_byte_at(src, i + 1u32) {
                    Option::Some(x) => { x }
                    Option::None => { 0u32 }
                };
                let mut width: u32 = 1u32;
                if b == 45u32 {
                    if nx == 62u32 { k = 28; width = 2u32; w = "->"; } else { k = 31; w = "-"; }
                } else if b == 33u32 {
                    if nx == 61u32 { k = 36; width = 2u32; w = "!="; } else { k = 43; w = "!"; }
                } else if b == 38u32 {
                    if nx == 38u32 { k = 41; width = 2u32; w = "&&"; }
                    else { return Lexed { toks: toks, err: "'&' is outside the supported subset", cat: "unsupported", errpos: i }; }
                } else {
                    return Lexed { toks: toks, err: "unexpected character", cat: "syntax", errpos: i };
                }
                toks = push(toks, Tok { kind: k, word: w, num: 0, pos: i });
                if width == 2u32 {
                    i = i + 2u32;
                    b = match text_byte_at(src, i) {
                        Option::Some(x) => { x }
                        Option::None => { 0u32 }
                    };
                } else {
                    i = i + 1u32;
                    b = nx;
                }
            }
        }
    }
    toks = push(toks, Tok { kind: 0, word: "<eof>", num: 0, pos: n });
    return Lexed { toks: toks, err: "", cat: "", errpos: n };
}
