// parser: tokens -> Prog (records and functions over a node arena).
Import "ast.sm"

record P {
    toks: Sequence(Tok),
    i: i32,
    nodes: Sequence(Node),
    funcs: Sequence(Func),
    recs: Sequence(Rec),
    err: text,
    cat: text,
    errpos: u32,
}

// A lexer result ends in one EOF token. A fast-path peek past it is
// NOT an expression: report the ordinary syntax error, never trap the VM.
fn safe_lookahead_kind(p: P, ahead: i32) -> i32 {
    let index: i32 = p.i + ahead;
    if index < 0 || index >= len(p.toks) { return 0; }
    return p.toks[index].kind;
}

fn safe_lookahead_token(p: P, ahead: i32) -> Tok {
    let index: i32 = p.i + ahead;
    if index < 0 || index >= len(p.toks) { return p.toks[len(p.toks) - 1]; }
    return p.toks[index];
}

fn fail_cat(p: P, cat: text, msg: text) -> P {
    if p.err != "" {
        return p;
    }
    let t: Tok = p.toks[p.i];
    return p with { err: msg + " (found '" + t.word + "')", cat: cat, errpos: t.pos };
}

fn expect(p: P, kind: i32, msg: text) -> P {
    if p.err != "" {
        return p;
    }
    if p.toks[p.i].kind == kind {
        return p with { i: p.i + 1 };
    }
    return fail_cat(p, "syntax", msg);
}

fn parse_type(p0: P) -> (P, i32) {
    let mut p: P = p0;
    let t: Tok = p.toks[p.i];
    let tk: i32 = t.kind;
    if tk == 10 || tk == 11 || tk == 54 || tk == 55 {
        let id: i32 = len(p.nodes);
        return (p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 60, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: t.word, pos: t.pos, kids: [] }) }, id);
    }
    if tk == 20 {
        p = p with { i: p.i + 1 };
        let mut kids: Sequence(i32) = [];
        while p.err == "" {
            let mut e: i32 = 0 - 1;
            (p, e) = parse_type(p);
            kids = push(kids, e);
            if p.err != "" { break; }
            if p.toks[p.i].kind == 27 {
                p = p with { i: p.i + 1 };
            } else {
                break;
            }
        }
        if p.err != "" { return (p, 0 - 1); }
        if p.toks[p.i].kind != 21 { return (fail_cat(p, "syntax", "expected ')'"), 0 - 1); }
        p = p with { i: p.i + 1 };
        if len(kids) < 2 {
            return (fail_cat(p, "unsupported", "parenthesized and unit types are outside the supported subset"), 0 - 1);
        }
        let id: i32 = len(p.nodes);
        return (p with { nodes: push(p.nodes, Node { k: 61, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: t.pos, kids: kids }) }, id);
    }
    if tk == 2 {
        p = p with { i: p.i + 1 };
        let mut kids: Sequence(i32) = [];
        if p.toks[p.i].kind == 20 {
            p = p with { i: p.i + 1 };
            while p.err == "" {
                let mut e: i32 = 0 - 1;
                (p, e) = parse_type(p);
                kids = push(kids, e);
                if p.err != "" { break; }
                if p.toks[p.i].kind == 27 {
                    p = p with { i: p.i + 1 };
                } else {
                    break;
                }
            }
            if p.err != "" { return (p, 0 - 1); }
            if p.toks[p.i].kind != 21 { return (fail_cat(p, "syntax", "expected ')'"), 0 - 1); }
            p = p with { i: p.i + 1 };
        }
        if p.err != "" { return (p, 0 - 1); }
        let id: i32 = len(p.nodes);
        return (p with { nodes: push(p.nodes, Node { k: 60, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: t.word, pos: t.pos, kids: kids }) }, id);
    }
    return (fail_cat(p, "syntax", "expected type"), 0 - 1);
}

fn parse_field_inits(p0: P) -> (P, Sequence(i32)) {
    let mut kids: Sequence(i32) = [];
    if p0.err != "" { return (p0, kids); }
    if p0.toks[p0.i].kind != 22 { return (fail_cat(p0, "syntax", "expected '{'"), kids); }
    let mut p: P = p0 with { i: p0.i + 1 };
    while p.toks[p.i].kind != 23 {
        let f: Tok = p.toks[p.i];
        if f.kind != 2 { return (fail_cat(p, "syntax", "expected field name"), kids); }
        if safe_lookahead_kind(p, 1) != 25 {
            return (fail_cat(p with { i: p.i + 1 }, "unsupported", "field punning is outside the supported subset"), kids);
        }
        let mut e: i32 = 0 - 1;
        (p, e) = parse_expr(p with { i: p.i + 2 }, 1);
        if p.err != "" { return (p, kids); }
        let fi: i32 = len(p.nodes);
        kids = push(kids, fi);
        if p.toks[p.i].kind == 27 {
            p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 31, a: e, b: 0 - 1, c: 0 - 1, v: 0, name: f.word, pos: f.pos, kids: [] }) };
        } else if p.toks[p.i].kind == 23 {
            p = p with { nodes: push(p.nodes, Node { k: 31, a: e, b: 0 - 1, c: 0 - 1, v: 0, name: f.word, pos: f.pos, kids: [] }) };
        } else {
            return (fail_cat(p, "syntax", "expected ',' or '}'"), kids);
        }
    }
    return (p with { i: p.i + 1 }, kids);
}

fn parse_block_expr(p0: P) -> (P, i32) {
    let open: Tok = p0.toks[p0.i];
    if p0.err != "" { return (p0, 0 - 1); }
    if open.kind != 22 { return (fail_cat(p0, "syntax", "expected '{'"), 0 - 1); }
    let mut p: P = p0 with { i: p0.i + 1 };
    let mut kids: Sequence(i32) = [];
    let mut tail: i32 = 0 - 1;
    while p.toks[p.i].kind != 23 {
        if p.err != "" { break; }
        if tail >= 0 { break; }
        let k: i32 = p.toks[p.i].kind;
        if k == 0 {
            p = fail_cat(p, "syntax", "expected '}'");
        } else if k == 3 || k == 6 || k == 15 {
            let mut s: i32 = 0 - 1;
            (p, s) = parse_stmt(p);
            kids = push(kids, s);
        } else {
            let mut is_stmt_only: bool = false;
            if k == 7 || k == 14 || k == 16 || k == 17 || k == 19 || k == 18 {
                is_stmt_only = true;
            } else if k == 2 {
                if safe_lookahead_kind(p, 1) == 26 {
                    is_stmt_only = true;
                }
            }
            if is_stmt_only {
                p = fail_cat(p, "unsupported", "statement-only form is not admitted in a value-producing block");
            } else {
                let mut e: i32 = 0 - 1;
                (p, e) = parse_expr(p, 1);
                let is_match: bool = if e >= 0 { p.nodes[e].k == 25 } else { false };
                if p.err == "" {
                    if p.toks[p.i].kind == 24 {
                        let s: i32 = len(p.nodes);
                        p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 16, a: e, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: open.pos, kids: [] }) };
                        kids = push(kids, s);
                    } else if is_match {
                        if p.toks[p.i].kind == 23 {
                            tail = e;
                        } else {
                            let s: i32 = len(p.nodes);
                            p = p with { nodes: push(p.nodes, Node { k: 16, a: e, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: open.pos, kids: [] }) };
                            kids = push(kids, s);
                        }
                    } else {
                        tail = e;
                    }
                }
            }
        }
    }
    if p.err != "" { return (p, 0 - 1); }
    if p.toks[p.i].kind != 23 { return (fail_cat(p, "syntax", "expected '}'"), 0 - 1); }
    let id: i32 = len(p.nodes);
    return (p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 27, a: tail, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: open.pos, kids: kids }) }, id);
}

fn parse_if_expr(p0: P) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    let mut p: P = p0 with { i: p0.i + 1 };
    let mut cond: i32 = 0 - 1;
    (p, cond) = parse_expr(p, 1);
    let mut thenb: i32 = 0 - 1;
    (p, thenb) = parse_block_expr(p);
    let mut elseb: i32 = 0 - 1;
    if p.err == "" {
        if p.toks[p.i].kind == 13 {
            p = p with { i: p.i + 1 };
            if p.toks[p.i].kind == 12 {
                (p, elseb) = parse_if_expr(p);
            } else {
                (p, elseb) = parse_block_expr(p);
            }
        } else {
            p = fail_cat(p, "syntax", "a value-producing 'if' needs an 'else' branch");
        }
    }
    if p.err != "" { return (p, 0 - 1); }
    let id: i32 = len(p.nodes);
    return (p with { nodes: push(p.nodes, Node { k: 26, a: cond, b: thenb, c: elseb, v: 0, name: "", pos: t.pos, kids: [] }) }, id);
}

fn parse_match(p0: P, statement: bool) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    let mut p: P = p0 with { i: p0.i + 1 };
    let mut scrut: i32 = 0 - 1;
    (p, scrut) = parse_expr(p, 1);
    p = expect(p, 22, "expected '{'");
    let mut arms: Sequence(i32) = [];
    while p.toks[p.i].kind != 23 {
        if p.err != "" { break; }
        let pt: Tok = p.toks[p.i];
        let mut kind: i32 = 0;
        let mut lit: i32 = 0;
        let mut bind: text = "";
        if pt.kind == 2 {
            if pt.word == "_" {
                p = p with { i: p.i + 1 };
            } else if pt.word == "N" || pt.word == "F" || pt.word == "T" || pt.word == "S" {
                kind = 5;
                lit = if pt.word == "N" { 0 } else if pt.word == "F" { 1 } else if pt.word == "T" { 2 } else { 3 };
                p = p with { i: p.i + 1 };
            } else if pt.word == "Option" {
                if safe_lookahead_kind(p, 1) == 49 {
                    p = p with { i: p.i + 2 };
                    let vt: Tok = p.toks[p.i];
                    p = expect(p, 2, "expected variant name");
                    if vt.word == "Some" {
                        kind = 3;
                        p = expect(p, 20, "expected '('");
                        let bt: Tok = p.toks[p.i];
                        p = expect(p, 2, "expected binding name");
                        bind = bt.word;
                        p = expect(p, 21, "expected ')'");
                    } else if vt.word == "None" {
                        kind = 4;
                    } else if p.err == "" {
                        p = fail_cat(p, "syntax", "unknown Option variant '" + vt.word + "'");
                    }
                } else {
                    p = fail_cat(p, "unsupported", "this match pattern is outside the supported subset");
                }
            } else {
                p = fail_cat(p, "unsupported", "this match pattern is outside the supported subset");
            }
        } else if pt.kind == 1 {
            kind = 1;
            lit = pt.num;
            p = p with { i: p.i + 1 };
        } else if pt.kind == 45 {
            kind = 2;
            lit = pt.num;
            p = p with { i: p.i + 1 };
        } else {
            p = fail_cat(p, "unsupported", "this match pattern is outside the supported subset");
        }
        if p.err == "" {
            if p.toks[p.i].kind == 12 {
                p = fail_cat(p, "unsupported", "match guards are outside the supported subset");
            }
        }
        p = expect(p, 50, "expected '=>'");
        let mut body: i32 = 0 - 1;
        if p.err == "" {
            if p.toks[p.i].kind == 22 {
                if statement {
                    let mut block: i32 = 0 - 1;
                    (p, block) = parse_block(p);
                    if p.err == "" {
                        body = len(p.nodes);
                        p = p with { nodes: push(p.nodes, Node { k: 27, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: pt.pos, kids: p.nodes[block].kids }) };
                    }
                } else {
                    (p, body) = parse_block_expr(p);
                }
            } else {
                (p, body) = parse_expr(p, 1);
            }
        }
        if p.err == "" {
            let arm: i32 = len(p.nodes);
            p = p with { nodes: push(p.nodes, Node { k: 32, a: body, b: lit, c: 0 - 1, v: kind, name: bind, pos: pt.pos, kids: [] }) };
            arms = push(arms, arm);
            if p.toks[p.i].kind == 27 {
                p = p with { i: p.i + 1 };
            }
        }
    }
    p = expect(p, 23, "expected '}'");
    if p.err != "" { return (p, 0 - 1); }
    let id: i32 = len(p.nodes);
    return (p with { nodes: push(p.nodes, Node { k: 25, a: scrut, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: t.pos, kids: arms }) }, id);
}

fn parse_expr(p0: P, minp: i32) -> (P, i32) {
    let mut p: P = p0;
    let mut lhs: i32 = 0 - 1;
    let t0: Tok = p.toks[p.i];
    if t0.kind == 31 || t0.kind == 43 {
        p = p with { i: p.i + 1 };
        (p, lhs) = parse_expr(p, 10);
        if p.err != "" { return (p, 0 - 1); }
        let uid: i32 = len(p.nodes);
        p = p with { nodes: push(p.nodes, Node { k: 5, a: lhs, b: 0 - 1, c: 0 - 1, v: t0.kind, name: "", pos: t0.pos, kids: [] }) };
        lhs = uid;
    } else {
        if t0.kind == 2 {
            let k1: i32 = safe_lookahead_kind(p, 1);
            if t0.word == "N" || t0.word == "F" || t0.word == "T" || t0.word == "S" {
                let qv: i32 = if t0.word == "N" { 0 } else if t0.word == "F" { 1 } else if t0.word == "T" { 2 } else { 3 };
                lhs = len(p.nodes);
                p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 9, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: qv, name: t0.word, pos: t0.pos, kids: [] }) };
            } else if k1 == 20 {
                p = p with { i: p.i + 2 };
                let mut args: Sequence(i32) = [];
                if p.toks[p.i].kind != 21 {
                    while p.err == "" {
                        let mut ae: i32 = 0 - 1;
                        let at: Tok = p.toks[p.i];
                        let ntk: i32 = safe_lookahead_kind(p, 1);
                        let mut ak: i32 = 0;
                        if ntk == 27 || ntk == 21 {
                            if at.kind == 2 {
                                if at.word != "N" && at.word != "F" && at.word != "T" && at.word != "S" { ak = 4; }
                            }
                            else if at.kind == 1 { ak = 1; }
                            else if at.kind == 44 { ak = 3; }
                            else if at.kind == 45 { ak = 8; }
                        }
                        if ak > 0 {
                            ae = len(p.nodes);
                            p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: ak, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: at.num, name: at.word, pos: at.pos, kids: [] }) };
                        } else {
                            (p, ae) = parse_expr(p, 1);
                        }
                        args = push(args, ae);
                        if p.err != "" { break; }
                        if p.toks[p.i].kind == 27 {
                            p = p with { i: p.i + 1 };
                        } else {
                            break;
                        }
                    }
                }
                if p.err != "" { return (p, 0 - 1); }
                if p.toks[p.i].kind != 21 { return (fail_cat(p, "syntax", "expected ')'"), 0 - 1); }
                lhs = len(p.nodes);
                p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 7, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: t0.word, pos: t0.pos, kids: args }) };
            } else if k1 == 22 {
                let mut is_rec_lit: bool = false;
                if p.i + 3 < len(p.toks) {
                    if safe_lookahead_kind(p, 2) == 2 {
                        if p.toks[p.i + 3].kind == 25 {
                            is_rec_lit = true;
                        }
                    }
                }
                if is_rec_lit {
                    let mut fields: Sequence(i32) = [];
                    (p, fields) = parse_field_inits(p with { i: p.i + 1 });
                    if p.err != "" { return (p, 0 - 1); }
                    lhs = len(p.nodes);
                    p = p with { nodes: push(p.nodes, Node { k: 29, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: t0.word, pos: t0.pos, kids: fields }) };
                } else {
                    lhs = len(p.nodes);
                    p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 4, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: t0.word, pos: t0.pos, kids: [] }) };
                }
            } else if k1 == 49 {
                return (fail_cat(p, "unsupported", "path expressions ('" + t0.word + "::...') are outside the supported subset"), 0 - 1);
            } else {
                lhs = len(p.nodes);
                p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 4, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: t0.word, pos: t0.pos, kids: [] }) };
            }
        } else if t0.kind == 1 || t0.kind == 45 || t0.kind == 44 || t0.kind == 8 || t0.kind == 9 {
            let pk: i32 = if t0.kind == 1 { 1 } else if t0.kind == 45 { 8 } else if t0.kind == 44 { 3 } else { 2 };
            let pv: i32 = if pk == 2 { if t0.kind == 8 { 1 } else { 0 } } else { t0.num };
            lhs = len(p.nodes);
            p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: pk, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: pv, name: t0.word, pos: t0.pos, kids: [] }) };
        } else if t0.kind == 22 {
            (p, lhs) = parse_block_expr(p);
        } else if t0.kind == 52 {
            (p, lhs) = parse_match(p, false);
        } else if t0.kind == 12 {
            (p, lhs) = parse_if_expr(p);
        } else if t0.kind == 20 {
            p = p with { i: p.i + 1 };
            if p.toks[p.i].kind == 21 {
                return (fail_cat(p, "unsupported", "unit expressions are outside the supported subset"), 0 - 1);
            }
            (p, lhs) = parse_expr(p, 1);
            if p.err == "" {
                if p.toks[p.i].kind == 27 {
                    let mut items: Sequence(i32) = [lhs];
                    p = p with { i: p.i + 1 };
                    if p.toks[p.i].kind != 21 {
                        while p.err == "" {
                            let mut te: i32 = 0 - 1;
                            (p, te) = parse_expr(p, 1);
                            items = push(items, te);
                            if p.err != "" { break; }
                            if p.toks[p.i].kind == 27 {
                                p = p with { i: p.i + 1 };
                            } else {
                                break;
                            }
                        }
                    }
                    if p.err != "" { return (p, 0 - 1); }
                    if p.toks[p.i].kind != 21 { return (fail_cat(p, "syntax", "expected ')'"), 0 - 1); }
                    lhs = len(p.nodes);
                    p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 22, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: t0.pos, kids: items }) };
                } else {
                    if p.toks[p.i].kind != 21 { return (fail_cat(p, "syntax", "expected ')'"), 0 - 1); }
                    p = p with { i: p.i + 1 };
                }
            }
        } else if t0.kind == 47 {
            p = p with { i: p.i + 1 };
            let mut items: Sequence(i32) = [];
            if p.toks[p.i].kind != 48 {
                while p.err == "" {
                    let mut se: i32 = 0 - 1;
                    (p, se) = parse_expr(p, 1);
                    items = push(items, se);
                    if p.err != "" { break; }
                    if p.toks[p.i].kind == 27 {
                        p = p with { i: p.i + 1 };
                    } else {
                        break;
                    }
                }
            }
            if p.err != "" { return (p, 0 - 1); }
            if p.toks[p.i].kind != 48 { return (fail_cat(p, "syntax", "expected ']'"), 0 - 1); }
            lhs = len(p.nodes);
            p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 23, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: t0.pos, kids: items }) };
        } else {
            return (fail_cat(p, "syntax", "expected expression"), 0 - 1);
        }

        while p.err == "" {
            let pt: Tok = p.toks[p.i];
            if pt.kind == 46 {
                if safe_lookahead_kind(p, 1) == 46 {
                    p = fail_cat(p, "unsupported", "ranges are outside the supported subset");
                } else {
                    p = p with { i: p.i + 1 };
                    let f: Tok = p.toks[p.i];
                    if f.kind == 1 {
                        p = fail_cat(p, "unsupported", "tuple field access is outside the supported subset");
                    } else if f.kind == 2 {
                        if safe_lookahead_kind(p, 1) == 20 {
                            p = fail_cat(p with { i: p.i + 1 }, "unsupported", "method calls are outside the supported subset");
                        } else {
                            let fid: i32 = len(p.nodes);
                            p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 20, a: lhs, b: 0 - 1, c: 0 - 1, v: 0, name: f.word, pos: f.pos, kids: [] }) };
                            lhs = fid;
                        }
                    } else {
                        p = fail_cat(p, "syntax", "expected field name");
                    }
                }
            } else if pt.kind == 47 {
                let it: Tok = safe_lookahead_token(p, 1);
                let mut ik: i32 = 0;
                if safe_lookahead_kind(p, 2) == 48 {
                    if it.kind == 2 { ik = 4; }
                    else if it.kind == 1 { ik = 1; }
                }
                if ik > 0 {
                    let ix: i32 = len(p.nodes);
                    let iid: i32 = ix + 1;
                    p = p with {
                        i: p.i + 3,
                        nodes: push(push(p.nodes,
                            Node { k: ik, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: it.num, name: it.word, pos: it.pos, kids: [] }),
                            Node { k: 24, a: lhs, b: ix, c: 0 - 1, v: 0, name: "", pos: pt.pos, kids: [] })
                    };
                    lhs = iid;
                } else {
                    let mut ix: i32 = 0 - 1;
                    (p, ix) = parse_expr(p with { i: p.i + 1 }, 1);
                    if p.err == "" {
                        if p.toks[p.i].kind == 48 {
                            let iid: i32 = len(p.nodes);
                            p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 24, a: lhs, b: ix, c: 0 - 1, v: 0, name: "", pos: pt.pos, kids: [] }) };
                            lhs = iid;
                        } else {
                            p = fail_cat(p, "syntax", "expected ']'");
                        }
                    }
                }
            } else if pt.kind == 53 {
                let mut fields: Sequence(i32) = [];
                (p, fields) = parse_field_inits(p with { i: p.i + 1 });
                if p.err == "" {
                    let wid: i32 = len(p.nodes);
                    p = p with { nodes: push(p.nodes, Node { k: 21, a: lhs, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: pt.pos, kids: fields }) };
                    lhs = wid;
                }
            } else {
                break;
            }
        }
    }

    if minp >= 10 {
        return (p, lhs);
    }

    while p.err == "" {
        let bt: Tok = p.toks[p.i];
        let btk: i32 = bt.kind;
        if btk < 30 { break; }
        if btk > 42 { break; }
        let pr: i32 = if btk <= 31 { 5 }
            else if btk <= 34 { 6 }
            else if btk <= 36 { 3 }
            else if btk <= 40 { 4 }
            else if btk == 41 { 2 }
            else { 1 };
        if pr < minp {
            break;
        }
        p = p with { i: p.i + 1 };
        let mut rhs: i32 = 0 - 1;
        let rt: Tok = p.toks[p.i];
        let ntk: i32 = safe_lookahead_kind(p, 1);
        let mut rk: i32 = 0;
        if ntk <= 27 {
            if ntk >= 21 {
                if rt.kind == 1 { rk = 1; }
                else if rt.kind == 2 {
                    if ntk != 22 {
                        if rt.word != "N" && rt.word != "F" && rt.word != "T" && rt.word != "S" { rk = 4; }
                    }
                }
                else if rt.kind == 45 { rk = 8; }
                else if rt.kind == 44 { rk = 3; }
            }
        }
        if rk > 0 {
            rhs = len(p.nodes);
            p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: rk, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: rt.num, name: rt.word, pos: rt.pos, kids: [] }) };
        } else {
            (p, rhs) = parse_expr(p, pr + 1);
        }
        if p.err != "" { break; }
        let bid: i32 = len(p.nodes);
        p = p with { nodes: push(p.nodes, Node { k: 6, a: lhs, b: rhs, c: 0 - 1, v: btk, name: "", pos: bt.pos, kids: [] }) };
        lhs = bid;
    }
    return (p, lhs);
}

fn parse_block(p0: P) -> (P, i32) {
    let open: Tok = p0.toks[p0.i];
    if p0.err != "" { return (p0, 0 - 1); }
    if open.kind != 22 { return (fail_cat(p0, "syntax", "expected '{'"), 0 - 1); }
    let mut p: P = p0 with { i: p0.i + 1 };
    let mut kids: Sequence(i32) = [];
    while p.toks[p.i].kind != 23 {
        if p.err != "" { break; }
        if p.toks[p.i].kind == 0 {
            p = fail_cat(p, "syntax", "expected '}'");
        } else {
            let mut s: i32 = 0 - 1;
            (p, s) = parse_stmt(p);
            kids = push(kids, s);
        }
    }
    if p.err != "" { return (p, 0 - 1); }
    if p.toks[p.i].kind != 23 { return (fail_cat(p, "syntax", "expected '}'"), 0 - 1); }
    let id: i32 = len(p.nodes);
    return (p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 15, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: open.pos, kids: kids }) }, id);
}

fn parse_name_list(p0: P) -> (P, Sequence(i32)) {
    let mut p: P = expect(p0, 20, "expected '('");
    let mut names: Sequence(i32) = [];
    while p.err == "" {
        let t: Tok = p.toks[p.i];
        if t.kind == 2 {
            let nd: i32 = len(p.nodes);
            p = p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 33, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: t.word, pos: t.pos, kids: [] }) };
            names = push(names, nd);
        } else {
            p = fail_cat(p, "syntax", "expected name");
        }
        if p.err != "" { break; }
        if p.toks[p.i].kind == 27 {
            p = p with { i: p.i + 1 };
        } else {
            break;
        }
    }
    p = expect(p, 21, "expected ')'");
    return (p, names);
}

fn parse_stmt(p0: P) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    let mut p: P = p0;
    let mut e: i32 = 0 - 1;
    if t.kind == 3 {
        p = p with { i: p.i + 1 };
        let mut is_mut: i32 = 0;
        if p.toks[p.i].kind == 4 {
            is_mut = 1;
            p = p with { i: p.i + 1 };
        }
        if p.toks[p.i].kind == 20 {
            let mut names: Sequence(i32) = [];
            (p, names) = parse_name_list(p);
            let mut ty: i32 = 0 - 1;
            if p.err == "" {
                if p.toks[p.i].kind == 25 {
                    (p, ty) = parse_type(p with { i: p.i + 1 });
                }
            }
            p = expect(p, 26, "expected '='");
            if p.err != "" { return (p, 0 - 1); }
            (p, e) = parse_expr(p, 1);
            p = expect(p, 24, "expected ';'");
            if p.err != "" { return (p, 0 - 1); }
            let id_node: i32 = len(p.nodes);
            return (p with { nodes: push(p.nodes, Node { k: 40, a: e, b: 0 - 1, c: is_mut, v: ty, name: "", pos: t.pos, kids: names }) }, id_node);
        }
        let id: Tok = p.toks[p.i];
        if id.kind == 2 { p = p with { i: p.i + 1 }; }
        else { return (fail_cat(p, "syntax", "expected variable name"), 0 - 1); }
        let mut ty: i32 = 0 - 1;
        if p.toks[p.i].kind == 25 {
            (p, ty) = parse_type(p with { i: p.i + 1 });
            if p.err != "" { return (p, 0 - 1); }
        }
        if p.toks[p.i].kind != 26 { return (fail_cat(p, "syntax", "expected '='"), 0 - 1); }
        p = p with { i: p.i + 1 };
        let vt: Tok = p.toks[p.i];
        let mut vk: i32 = 0;
        if safe_lookahead_kind(p, 1) == 24 {
            if vt.kind == 1 { vk = 1; }
            else if vt.kind == 2 { if vt.word != "N" && vt.word != "F" && vt.word != "T" && vt.word != "S" { vk = 4; } }
            else if vt.kind == 44 { vk = 3; }
            else if vt.kind == 45 { vk = 8; }
            else if vt.kind == 8 || vt.kind == 9 { vk = 2; }
        }
        if vk > 0 {
            let vv: i32 = if vk == 2 { if vt.kind == 8 { 1 } else { 0 } } else { vt.num };
            e = len(p.nodes);
            p = p with { i: p.i + 2, nodes: push(p.nodes, Node { k: vk, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: vv, name: vt.word, pos: vt.pos, kids: [] }) };
        } else {
            (p, e) = parse_expr(p, 1);
            if p.err != "" { return (p, 0 - 1); }
            if p.toks[p.i].kind != 24 { return (fail_cat(p, "syntax", "expected ';'"), 0 - 1); }
            p = p with { i: p.i + 1 };
        }
        let id_node: i32 = len(p.nodes);
        return (p with { nodes: push(p.nodes, Node { k: 10, a: e, b: 0 - 1, c: is_mut, v: ty, name: id.word, pos: id.pos, kids: [] }) }, id_node);
    }
    if t.kind == 2 {
        let k1: i32 = safe_lookahead_kind(p, 1);
        if k1 == 26 {
            p = p with { i: p.i + 2 };
            let vt: Tok = p.toks[p.i];
            let mut vk: i32 = 0;
            if safe_lookahead_kind(p, 1) == 24 {
                if vt.kind == 1 { vk = 1; }
                else if vt.kind == 2 { if vt.word != "N" && vt.word != "F" && vt.word != "T" && vt.word != "S" { vk = 4; } }
                else if vt.kind == 44 { vk = 3; }
                else if vt.kind == 45 { vk = 8; }
                else if vt.kind == 8 || vt.kind == 9 { vk = 2; }
            }
            if vk > 0 {
                let vv: i32 = if vk == 2 { if vt.kind == 8 { 1 } else { 0 } } else { vt.num };
                e = len(p.nodes);
                p = p with { i: p.i + 2, nodes: push(p.nodes, Node { k: vk, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: vv, name: vt.word, pos: vt.pos, kids: [] }) };
            } else {
                (p, e) = parse_expr(p, 1);
                if p.err != "" { return (p, 0 - 1); }
                if p.toks[p.i].kind != 24 { return (fail_cat(p, "syntax", "expected ';'"), 0 - 1); }
                p = p with { i: p.i + 1 };
            }
            let id_node: i32 = len(p.nodes);
            return (p with { nodes: push(p.nodes, Node { k: 11, a: e, b: 0 - 1, c: 0 - 1, v: 0, name: t.word, pos: t.pos, kids: [] }) }, id_node);
        }
        if k1 >= 30 {
            if k1 <= 34 {
                if p.i + 2 < len(p.toks) {
                    if safe_lookahead_kind(p, 2) == 26 {
                        return (fail_cat(p with { i: p.i + 1 }, "unsupported", "compound assignment is outside the supported subset"), 0 - 1);
                    }
                }
            }
        }
    }
    if t.kind == 12 {
        p = p with { i: p.i + 1 };
        let mut cond: i32 = 0 - 1;
        (p, cond) = parse_expr(p, 1);
        let mut thenb: i32 = 0 - 1;
        (p, thenb) = parse_block(p);
        let mut elseb: i32 = 0 - 1;
        if p.err == "" {
            if p.toks[p.i].kind == 13 {
                p = p with { i: p.i + 1 };
                if p.toks[p.i].kind == 12 {
                    (p, elseb) = parse_stmt(p);
                } else {
                    (p, elseb) = parse_block(p);
                }
            }
        }
        if p.err != "" { return (p, 0 - 1); }
        let id_node: i32 = len(p.nodes);
        return (p with { nodes: push(p.nodes, Node { k: 12, a: cond, b: thenb, c: elseb, v: 0, name: "", pos: t.pos, kids: [] }) }, id_node);
    }
    if t.kind == 7 {
        p = p with { i: p.i + 1 };
        if p.toks[p.i].kind == 24 {
            let id_node: i32 = len(p.nodes);
            return (p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 14, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: t.pos, kids: [] }) }, id_node);
        }
        (p, e) = parse_expr(p, 1);
        if p.err != "" { return (p, 0 - 1); }
        if p.toks[p.i].kind != 24 { return (fail_cat(p, "syntax", "expected ';'"), 0 - 1); }
        let id_node: i32 = len(p.nodes);
        return (p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 14, a: e, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: t.pos, kids: [] }) }, id_node);
    }
    if t.kind == 14 {
        p = p with { i: p.i + 1 };
        let mut cond: i32 = 0 - 1;
        (p, cond) = parse_expr(p, 1);
        let mut body: i32 = 0 - 1;
        (p, body) = parse_block(p);
        if p.err != "" { return (p, 0 - 1); }
        let id_node: i32 = len(p.nodes);
        return (p with { nodes: push(p.nodes, Node { k: 13, a: cond, b: body, c: 0 - 1, v: 0, name: "", pos: t.pos, kids: [] }) }, id_node);
    }
    if t.kind == 19 {
        p = p with { i: p.i + 1 };
        let nt: Tok = p.toks[p.i];
        p = expect(p, 2, "expected loop variable");
        p = expect(p, 56, "expected 'in'");
        if p.err != "" { return (p, 0 - 1); }
        (p, e) = parse_expr(p, 1);
        if p.err == "" {
            if p.toks[p.i].kind == 46 {
                return (fail_cat(p, "unsupported", "range loops are outside the supported subset"), 0 - 1);
            }
        }
        let mut body: i32 = 0 - 1;
        (p, body) = parse_block(p);
        if p.err != "" { return (p, 0 - 1); }
        let id_node: i32 = len(p.nodes);
        return (p with { nodes: push(p.nodes, Node { k: 42, a: e, b: body, c: 0 - 1, v: 0, name: nt.word, pos: t.pos, kids: [] }) }, id_node);
    }
    if t.kind == 20 {
        let mut is_tup_assign: bool = false;
        if p.i + 2 < len(p.toks) {
            if safe_lookahead_kind(p, 1) == 2 {
                if safe_lookahead_kind(p, 2) == 27 {
                    let mut depth: i32 = 1;
                    let mut ti: i32 = p.i + 1;
                    let tlen: i32 = len(p.toks);
                    while depth > 0 {
                        if ti >= tlen { break; }
                        let tk: i32 = p.toks[ti].kind;
                        if tk == 0 { break; }
                        if tk == 20 { depth = depth + 1; }
                        if tk == 21 { depth = depth - 1; }
                        ti = ti + 1;
                    }
                    if depth == 0 {
                        if ti < tlen {
                            if p.toks[ti].kind == 26 {
                                is_tup_assign = true;
                            }
                        }
                    }
                }
            }
        }
        if is_tup_assign {
            let mut names: Sequence(i32) = [];
            (p, names) = parse_name_list(p);
            if p.err != "" { return (p, 0 - 1); }
            if p.toks[p.i].kind != 26 { return (fail_cat(p, "syntax", "expected '='"), 0 - 1); }
            (p, e) = parse_expr(p with { i: p.i + 1 }, 1);
            if p.err != "" { return (p, 0 - 1); }
            if p.toks[p.i].kind != 24 { return (fail_cat(p, "syntax", "expected ';'"), 0 - 1); }
            let id_node: i32 = len(p.nodes);
            return (p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 41, a: e, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: t.pos, kids: names }) }, id_node);
        }
    }
    if t.kind == 6 {
        p = expect(p with { i: p.i + 1 }, 20, "expected '('");
        if p.err != "" { return (p, 0 - 1); }
        (p, e) = parse_expr(p, 1);
        p = expect(expect(p, 21, "expected ')'"), 24, "expected ';'");
        if p.err != "" { return (p, 0 - 1); }
        let id_node: i32 = len(p.nodes);
        return (p with { nodes: push(p.nodes, Node { k: 17, a: e, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: t.pos, kids: [] }) }, id_node);
    }
    if t.kind == 16 || t.kind == 17 {
        if safe_lookahead_kind(p, 1) != 24 { return (fail_cat(p with { i: p.i + 1 }, "syntax", "expected ';'"), 0 - 1); }
        let k: i32 = if t.kind == 16 { 18 } else { 19 };
        let id_node: i32 = len(p.nodes);
        return (p with { i: p.i + 2, nodes: push(p.nodes, Node { k: k, a: 0 - 1, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: t.pos, kids: [] }) }, id_node);
    }
    if t.kind == 15 || t.kind == 18 {
        return (fail_cat(p, "unsupported", "'" + t.word + "' is outside the supported subset"), 0 - 1);
    }
    if t.kind == 22 {
        return (fail_cat(p, "unsupported", "a bare block is a value-producing block expression in Semantic; outside the subset"), 0 - 1);
    }
    if t.kind == 52 {
        (p, e) = parse_match(p, true);
        if p.err == "" {
            if p.toks[p.i].kind == 24 {
                p = p with { i: p.i + 1 };
            }
        }
        if p.err != "" { return (p, 0 - 1); }
        let id_node: i32 = len(p.nodes);
        return (p with { nodes: push(p.nodes, Node { k: 16, a: e, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: t.pos, kids: [] }) }, id_node);
    }
    (p, e) = parse_expr(p, 1);
    if p.err != "" { return (p, 0 - 1); }
    if p.toks[p.i].kind != 24 { return (fail_cat(p, "syntax", "expected ';'"), 0 - 1); }
    let id_node: i32 = len(p.nodes);
    return (p with { i: p.i + 1, nodes: push(p.nodes, Node { k: 16, a: e, b: 0 - 1, c: 0 - 1, v: 0, name: "", pos: t.pos, kids: [] }) }, id_node);
}

fn parse_func(p0: P) -> P {
    let fn_tok: Tok = p0.toks[p0.i];
    let mut p: P = p0 with { i: p0.i + 1 };
    let name: Tok = p.toks[p.i];
    p = expect(expect(p, 2, "expected function name"), 20, "expected '('");
    let mut pnames: Sequence(text) = [];
    let mut ptypes: Sequence(i32) = [];
    if p.err == "" {
        if p.toks[p.i].kind != 21 {
            while p.err == "" {
                let pn: Tok = p.toks[p.i];
                p = expect(expect(p, 2, "expected parameter name"), 25, "expected ':'");
                let mut pt: i32 = 0 - 1;
                if p.err == "" {
                    (p, pt) = parse_type(p);
                }
                if p.err == "" {
                    if p.toks[p.i].kind == 26 {
                        p = fail_cat(p, "unsupported", "default parameters are outside the supported subset");
                    }
                }
                pnames = push(pnames, pn.word);
                ptypes = push(ptypes, pt);
                if p.err != "" { break; }
                if p.toks[p.i].kind == 27 {
                    p = p with { i: p.i + 1 };
                } else {
                    break;
                }
            }
        }
    }
    p = expect(p, 21, "expected ')'");
    let mut ret: i32 = 0 - 1;
    if p.err == "" {
        if p.toks[p.i].kind == 28 {
            (p, ret) = parse_type(p with { i: p.i + 1 });
        }
    }
    if p.err == "" {
        if p.toks[p.i].kind == 2 {
            let w: text = p.toks[p.i].word;
            if w == "requires" || w == "ensures" || w == "invariant" {
                return fail_cat(p, "unsupported", "function contracts are outside the supported subset");
            }
        }
        if p.toks[p.i].kind == 26 {
            return fail_cat(p, "unsupported", "expression-bodied functions are outside the supported subset");
        }
    }
    let mut body: i32 = 0 - 1;
    (p, body) = parse_block(p);
    if p.err != "" { return p; }
    let f: Func = Func { name: name.word, pnames: pnames, ptypes: ptypes, ret: ret, body: body, pos: fn_tok.pos };
    return p with { funcs: push(p.funcs, f) };
}

fn parse_record(p0: P) -> P {
    let rt: Tok = p0.toks[p0.i];
    let mut p: P = p0 with { i: p0.i + 1 };
    let name: Tok = p.toks[p.i];
    p = expect(expect(p, 2, "expected record name"), 22, "expected '{'");
    let mut fnames: Sequence(text) = [];
    let mut ftypes: Sequence(i32) = [];
    while p.toks[p.i].kind != 23 {
        if p.err != "" { break; }
        let f: Tok = p.toks[p.i];
        p = expect(expect(p, 2, "expected field name"), 25, "expected ':'");
        let mut ft: i32 = 0 - 1;
        if p.err == "" {
            (p, ft) = parse_type(p);
        }
        fnames = push(fnames, f.word);
        ftypes = push(ftypes, ft);
        if p.err == "" {
            if p.toks[p.i].kind == 27 {
                p = p with { i: p.i + 1 };
            } else if p.toks[p.i].kind != 23 {
                p = fail_cat(p, "syntax", "expected ',' or '}'");
            }
        }
    }
    p = expect(p, 23, "expected '}'");
    if p.err != "" { return p; }
    if len(fnames) == 0 {
        return p with { err: "record declarations must be non-empty", cat: "type", errpos: rt.pos };
    }
    return p with { recs: push(p.recs, Rec { name: name.word, fnames: fnames, ftypes: ftypes, pos: rt.pos }) };
}

fn parse_program(toks: Sequence(Tok)) -> P {
    let mut p: P = P { toks: toks, i: 0, nodes: [], funcs: [], recs: [], err: "", cat: "", errpos: 0u32 };
    while p.toks[p.i].kind != 0 {
        if p.err != "" { break; }
        let t: Tok = p.toks[p.i];
        if t.kind == 5 {
            p = parse_func(p);
        } else if t.kind == 51 {
            p = parse_record(p);
        } else if t.kind == 2 {
            p = fail_cat(p, "unsupported", "top-level item '" + t.word + "' is outside the supported subset (only functions and records)");
        } else {
            p = fail_cat(p, "syntax", "expected 'fn'");
        }
    }
    return p;
}
