// parser: tokens -> Prog (functions over a node arena).
//
// Tokens are read directly (p.toks[p.i]) rather than through helper functions:
// user-function calls count against the VM's per-run Calls quota. A token is
// consumed only after it matched a non-EOF kind, and EOF is the last token, so
// p.i never leaves the sequence.
//
// Recursive descent for items and statements, precedence climbing for binary
// expressions. The parser state is threaded through every function as a value;
// the first error wins and later steps leave the state unchanged.
Import "ast.sm"

record P {
    toks: Sequence(Tok),
    i: i32,
    nodes: Sequence(Node),
    funcs: Sequence(Func),
    err: text,
    cat: text,
    errpos: u32,
}

fn peek_kind_at(p: P, ahead: i32) -> i32 {
    let j: i32 = p.i + ahead;
    if j < len(p.toks) {
        return p.toks[j].kind;
    }
    return 0;
}

fn fail_cat(p: P, cat: text, msg: text) -> P {
    if p.err != "" {
        return p;
    }
    let t: Tok = p.toks[p.i];
    return p with { err: msg + " (found '" + t.word + "')", cat: cat, errpos: t.pos };
}

fn expect(p: P, kind: i32, what: text) -> P {
    if p.err != "" {
        return p;
    }
    if p.toks[p.i].kind != kind {
        return fail_cat(p, "syntax", "expected " + what);
    }
    return p with { i: p.i + 1 };
}

fn add_node(p: P, k: i32, a: i32, b: i32, c: i32, v: i32, name: text, pos: u32, kids: Sequence(i32)) -> (P, i32) {
    let id: i32 = len(p.nodes);
    let nd: Node = Node { k: k, a: a, b: b, c: c, v: v, name: name, pos: pos, kids: kids };
    return (p with { nodes: push(p.nodes, nd) }, id);
}

// Binding power of a binary operator token; 0 if it is not one.
fn prec(kind: i32) -> i32 {
    return match kind {
        42 => { 1 }
        41 => { 2 }
        35 => { 3 }
        36 => { 3 }
        37 => { 4 }
        38 => { 4 }
        39 => { 4 }
        40 => { 4 }
        30 => { 5 }
        31 => { 5 }
        32 => { 6 }
        33 => { 6 }
        34 => { 6 }
        _ => { 0 }
    };
}

// Type annotation: i32 or bool; anything else is outside the subset.
fn parse_type(p0: P) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    if t.kind == 10 { return (p0 with { i: p0.i + 1 }, 1); }
    if t.kind == 11 { return (p0 with { i: p0.i + 1 }, 2); }
    if t.kind == 2 || t.kind == 20 {
        return (fail_cat(p0, "unsupported", "only i32 and bool types are supported"), 0);
    }
    return (fail_cat(p0, "syntax", "expected type"), 0);
}

fn parse_primary(p0: P) -> (P, i32) {
    let mut p: P = p0;
    let t: Tok = p.toks[p.i];
    if t.kind == 1 {
        return add_node(p with { i: p.i + 1 }, 1, 0 - 1, 0 - 1, 0 - 1, t.num, "", t.pos, []);
    }
    if t.kind == 8 || t.kind == 9 {
        let v: i32 = if t.kind == 8 { 1 } else { 0 };
        return add_node(p with { i: p.i + 1 }, 2, 0 - 1, 0 - 1, 0 - 1, v, "", t.pos, []);
    }
    if t.kind == 2 {
        if peek_kind_at(p, 1) == 20 {
            // direct call: name(arg, ...)
            p = p with { i: p.i + 2 };
            let mut args: Sequence(i32) = [];
            if p.toks[p.i].kind != 21 {
                let mut more: bool = true;
                while more && p.err == "" {
                    let mut e: i32 = 0 - 1;
                    (p, e) = parse_expr(p, 1);
                    args = push(args, e);
                    if p.err == "" && p.toks[p.i].kind == 27 {
                        p = p with { i: p.i + 1 };
                    } else {
                        more = false;
                    }
                }
            }
            p = expect(p, 21, "')'");
            if p.err != "" { return (p, 0 - 1); }
            return add_node(p, 7, 0 - 1, 0 - 1, 0 - 1, 0, t.word, t.pos, args);
        }
        return add_node(p with { i: p.i + 1 }, 4, 0 - 1, 0 - 1, 0 - 1, 0, t.word, t.pos, []);
    }
    if t.kind == 20 {
        p = p with { i: p.i + 1 };
        if p.toks[p.i].kind == 21 {
            return (fail_cat(p, "unsupported", "unit and tuple expressions are outside the supported subset"), 0 - 1);
        }
        let mut e: i32 = 0 - 1;
        (p, e) = parse_expr(p, 1);
        if p.err == "" && p.toks[p.i].kind == 27 {
            return (fail_cat(p, "unsupported", "tuple expressions are outside the supported subset"), 0 - 1);
        }
        p = expect(p, 21, "')'");
        return (p, e);
    }
    return (fail_cat(p, "syntax", "expected expression"), 0 - 1);
}

fn parse_unary(p0: P) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    if t.kind == 31 || t.kind == 43 {
        let mut p: P = p0 with { i: p0.i + 1 };
        let mut e: i32 = 0 - 1;
        (p, e) = parse_unary(p);
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 5, e, 0 - 1, 0 - 1, t.kind, "", t.pos, []);
    }
    return parse_primary(p0);
}

// Precedence climbing; every binary operator is left-associative.
fn parse_expr(p0: P, minp: i32) -> (P, i32) {
    let mut p: P = p0;
    let mut lhs: i32 = 0 - 1;
    (p, lhs) = parse_unary(p);
    while p.err == "" {
        let t: Tok = p.toks[p.i];
        let pr: i32 = prec(t.kind);
        if pr == 0 || pr < minp {
            break;
        }
        p = p with { i: p.i + 1 };
        let mut rhs: i32 = 0 - 1;
        (p, rhs) = parse_expr(p, pr + 1);
        if p.err != "" { break; }
        (p, lhs) = add_node(p, 6, lhs, rhs, 0 - 1, t.kind, "", t.pos, []);
    }
    return (p, lhs);
}

fn parse_block(p0: P) -> (P, i32) {
    let open: Tok = p0.toks[p0.i];
    let mut p: P = expect(p0, 22, "'{'");
    let mut kids: Sequence(i32) = [];
    while p.err == "" && p.toks[p.i].kind != 23 {
        if p.toks[p.i].kind == 0 {
            p = fail_cat(p, "syntax", "expected '}'");
        } else {
            let mut s: i32 = 0 - 1;
            (p, s) = parse_stmt(p);
            kids = push(kids, s);
        }
    }
    p = expect(p, 23, "'}'");
    if p.err != "" { return (p, 0 - 1); }
    return add_node(p, 15, 0 - 1, 0 - 1, 0 - 1, 0, "", open.pos, kids);
}

fn parse_if(p0: P) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    let mut p: P = p0 with { i: p0.i + 1 };
    let mut cond: i32 = 0 - 1;
    (p, cond) = parse_expr(p, 1);
    let mut thenb: i32 = 0 - 1;
    (p, thenb) = parse_block(p);
    let mut elseb: i32 = 0 - 1;
    if p.err == "" && p.toks[p.i].kind == 13 {
        p = p with { i: p.i + 1 };
        if p.toks[p.i].kind == 12 {
            (p, elseb) = parse_if(p);
        } else {
            (p, elseb) = parse_block(p);
        }
    }
    if p.err != "" { return (p, 0 - 1); }
    return add_node(p, 12, cond, thenb, elseb, 0, "", t.pos, []);
}

fn parse_stmt(p0: P) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    let mut p: P = p0;
    let mut e: i32 = 0 - 1;
    if t.kind == 3 {
        p = p with { i: p.i + 1 };
        let mut is_mut: i32 = 0;
        if p.toks[p.i].kind == 4 {
            is_mut = 1;
            p = p with { i: p.i + 1 };
        }
        let id: Tok = p.toks[p.i];
        if id.kind == 20 {
            return (fail_cat(p, "unsupported", "tuple destructuring is outside the supported subset"), 0 - 1);
        }
        p = expect(p, 2, "variable name");
        let mut ty: i32 = 0;
        if p.err == "" && p.toks[p.i].kind == 25 {
            (p, ty) = parse_type(p with { i: p.i + 1 });
        }
        p = expect(p, 26, "'='");
        if p.err != "" { return (p, 0 - 1); }
        (p, e) = parse_expr(p, 1);
        p = expect(p, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 10, e, 0 - 1, is_mut, ty, id.word, id.pos, []);
    }
    if t.kind == 2 && peek_kind_at(p, 1) == 26 {
        p = p with { i: p.i + 2 };
        (p, e) = parse_expr(p, 1);
        p = expect(p, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 11, e, 0 - 1, 0 - 1, 0, t.word, t.pos, []);
    }
    if t.kind == 2 && peek_kind_at(p, 2) == 26 {
        let op: i32 = peek_kind_at(p, 1);
        if op >= 30 && op <= 34 {
            return (fail_cat(p with { i: p.i + 1 }, "unsupported", "compound assignment is outside the supported subset"), 0 - 1);
        }
    }
    if t.kind == 6 {
        p = expect(p with { i: p.i + 1 }, 20, "'('");
        if p.err != "" { return (p, 0 - 1); }
        (p, e) = parse_expr(p, 1);
        p = expect(p, 21, "')'");
        p = expect(p, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 17, e, 0 - 1, 0 - 1, 0, "", t.pos, []);
    }
    if t.kind == 7 {
        p = p with { i: p.i + 1 };
        if p.toks[p.i].kind == 24 {
            return add_node(p with { i: p.i + 1 }, 14, 0 - 1, 0 - 1, 0 - 1, 0, "", t.pos, []);
        }
        (p, e) = parse_expr(p, 1);
        p = expect(p, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 14, e, 0 - 1, 0 - 1, 0, "", t.pos, []);
    }
    if t.kind == 12 {
        return parse_if(p);
    }
    if t.kind == 14 {
        p = p with { i: p.i + 1 };
        let mut cond: i32 = 0 - 1;
        (p, cond) = parse_expr(p, 1);
        let mut body: i32 = 0 - 1;
        (p, body) = parse_block(p);
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 13, cond, body, 0 - 1, 0, "", t.pos, []);
    }
    if t.kind == 16 || t.kind == 17 {
        p = expect(p with { i: p.i + 1 }, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        let k: i32 = if t.kind == 16 { 18 } else { 19 };
        return add_node(p, k, 0 - 1, 0 - 1, 0 - 1, 0, "", t.pos, []);
    }
    if t.kind == 15 || t.kind == 18 || t.kind == 19 {
        return (fail_cat(p, "unsupported", "'" + t.word + "' is outside the supported subset"), 0 - 1);
    }
    if t.kind == 22 {
        return (fail_cat(p, "unsupported", "a bare block is a value-producing block expression in Semantic; outside the subset"), 0 - 1);
    }
    if t.kind == 1 || t.kind == 2 || t.kind == 8 || t.kind == 9 || t.kind == 20 || t.kind == 31 || t.kind == 43 {
        (p, e) = parse_expr(p, 1);
        p = expect(p, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 16, e, 0 - 1, 0 - 1, 0, "", t.pos, []);
    }
    return (fail_cat(p, "syntax", "expected statement"), 0 - 1);
}

// fn name(param: type, ...) [-> type] block
fn parse_func(p0: P) -> P {
    let fn_tok: Tok = p0.toks[p0.i];
    let mut p: P = p0 with { i: p0.i + 1 };
    let name: Tok = p.toks[p.i];
    p = expect(p, 2, "function name");
    p = expect(p, 20, "'('");
    let mut pnames: Sequence(text) = [];
    let mut ptypes: Sequence(i32) = [];
    if p.err == "" && p.toks[p.i].kind != 21 {
        let mut more: bool = true;
        while more && p.err == "" {
            let pn: Tok = p.toks[p.i];
            p = expect(p, 2, "parameter name");
            p = expect(p, 25, "':'");
            let mut pt: i32 = 0;
            if p.err == "" {
                (p, pt) = parse_type(p);
            }
            if p.err == "" && p.toks[p.i].kind == 26 {
                p = fail_cat(p, "unsupported", "default parameters are outside the supported subset");
            }
            pnames = push(pnames, pn.word);
            ptypes = push(ptypes, pt);
            if p.err == "" && p.toks[p.i].kind == 27 {
                p = p with { i: p.i + 1 };
            } else {
                more = false;
            }
        }
    }
    p = expect(p, 21, "')'");
    let mut ret: i32 = 0;
    if p.err == "" && p.toks[p.i].kind == 28 {
        (p, ret) = parse_type(p with { i: p.i + 1 });
    }
    if p.err == "" && p.toks[p.i].kind == 2 {
        let w: text = p.toks[p.i].word;
        if w == "requires" || w == "ensures" || w == "invariant" {
            return fail_cat(p, "unsupported", "function contracts are outside the supported subset");
        }
    }
    if p.err == "" && p.toks[p.i].kind == 26 {
        return fail_cat(p, "unsupported", "expression-bodied functions are outside the supported subset");
    }
    let mut body: i32 = 0 - 1;
    (p, body) = parse_block(p);
    if p.err != "" { return p; }
    let f: Func = Func { name: name.word, pnames: pnames, ptypes: ptypes, ret: ret, body: body, pos: fn_tok.pos };
    return p with { funcs: push(p.funcs, f) };
}

fn parse_program(toks: Sequence(Tok)) -> P {
    let mut p: P = P { toks: toks, i: 0, nodes: [], funcs: [], err: "", cat: "", errpos: 0u32 };
    while p.err == "" && p.toks[p.i].kind != 0 {
        let t: Tok = p.toks[p.i];
        if t.kind == 5 {
            p = parse_func(p);
        } else if t.kind == 2 {
            p = fail_cat(p, "unsupported", "top-level item '" + t.word + "' is outside the supported subset (only functions)");
        } else {
            p = fail_cat(p, "syntax", "expected 'fn'");
        }
    }
    return p;
}
