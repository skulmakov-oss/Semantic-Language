// parser: tokens -> Prog (records and functions over a node arena).
//
// Tokens are read directly (p.toks[p.i]) rather than through helper functions:
// user-function calls count against the VM's per-run Calls quota. A token is
// consumed only after it matched a non-EOF kind, and EOF is the last token, so
// p.i never leaves the sequence.
//
// Recursive descent for items and statements, precedence climbing for binary
// expressions. The parser state is threaded through every function as a value;
// the first error wins and later steps leave the state unchanged.
Import "ast.sm"

record P {
    toks: Sequence(Tok),
    i: i32,
    nodes: Sequence(Node),
    funcs: Sequence(Func),
    recs: Sequence(Rec),
    err: text,
    cat: text,
    errpos: u32,
}

fn kind_at(p: P, ahead: i32) -> i32 {
    let j: i32 = p.i + ahead;
    if j < len(p.toks) {
        return p.toks[j].kind;
    }
    return 0;
}

fn fail_cat(p: P, cat: text, msg: text) -> P {
    if p.err != "" {
        return p;
    }
    let t: Tok = p.toks[p.i];
    return p with { err: msg + " (found '" + t.word + "')", cat: cat, errpos: t.pos };
}

fn expect(p: P, kind: i32, what: text) -> P {
    if p.err != "" {
        return p;
    }
    if p.toks[p.i].kind != kind {
        return fail_cat(p, "syntax", "expected " + what);
    }
    return p with { i: p.i + 1 };
}

fn add_node(p: P, k: i32, a: i32, b: i32, c: i32, v: i32, name: text, pos: u32, kids: Sequence(i32)) -> (P, i32) {
    let id: i32 = len(p.nodes);
    let nd: Node = Node { k: k, a: a, b: b, c: c, v: v, name: name, pos: pos, kids: kids };
    return (p with { nodes: push(p.nodes, nd) }, id);
}

// Binding power of a binary operator token; 0 if it is not one.
fn prec(kind: i32) -> i32 {
    return match kind {
        42 => { 1 }
        41 => { 2 }
        35 => { 3 }
        36 => { 3 }
        37 => { 4 }
        38 => { 4 }
        39 => { 4 }
        40 => { 4 }
        30 => { 5 }
        31 => { 5 }
        32 => { 6 }
        33 => { 6 }
        34 => { 6 }
        _ => { 0 }
    };
}

// type = i32 | bool | u32 | text | Name | Name "(" type {"," type} ")" | "(" type "," type {"," type} ")"
fn parse_type(p0: P) -> (P, i32) {
    let mut p: P = p0;
    let t: Tok = p.toks[p.i];
    if t.kind == 10 || t.kind == 11 || t.kind == 54 || t.kind == 55 {
        return add_node(p with { i: p.i + 1 }, 60, 0 - 1, 0 - 1, 0 - 1, 0, t.word, t.pos, []);
    }
    if t.kind == 20 {
        p = p with { i: p.i + 1 };
        let mut kids: Sequence(i32) = [];
        let mut more: bool = true;
        while more && p.err == "" {
            let mut e: i32 = 0 - 1;
            (p, e) = parse_type(p);
            kids = push(kids, e);
            if p.err == "" && p.toks[p.i].kind == 27 {
                p = p with { i: p.i + 1 };
            } else {
                more = false;
            }
        }
        p = expect(p, 21, "')'");
        if p.err != "" { return (p, 0 - 1); }
        if len(kids) < 2 {
            return (fail_cat(p, "unsupported", "parenthesized and unit types are outside the supported subset"), 0 - 1);
        }
        return add_node(p, 61, 0 - 1, 0 - 1, 0 - 1, 0, "", t.pos, kids);
    }
    if t.kind == 2 {
        p = p with { i: p.i + 1 };
        let mut kids: Sequence(i32) = [];
        if p.toks[p.i].kind == 20 {
            p = p with { i: p.i + 1 };
            let mut more: bool = true;
            while more && p.err == "" {
                let mut e: i32 = 0 - 1;
                (p, e) = parse_type(p);
                kids = push(kids, e);
                if p.err == "" && p.toks[p.i].kind == 27 {
                    p = p with { i: p.i + 1 };
                } else {
                    more = false;
                }
            }
            p = expect(p, 21, "')'");
        }
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 60, 0 - 1, 0 - 1, 0 - 1, 0, t.word, t.pos, kids);
    }
    return (fail_cat(p, "syntax", "expected type"), 0 - 1);
}

// "{" field ":" expr {"," field ":" expr} [","] "}"  ->  FieldInit nodes
fn parse_field_inits(p0: P) -> (P, Sequence(i32)) {
    let mut p: P = expect(p0, 22, "'{'");
    let mut kids: Sequence(i32) = [];
    while p.err == "" && p.toks[p.i].kind != 23 {
        let f: Tok = p.toks[p.i];
        p = expect(p, 2, "field name");
        if p.err == "" && p.toks[p.i].kind != 25 {
            return (fail_cat(p, "unsupported", "field punning is outside the supported subset"), kids);
        }
        p = expect(p, 25, "':'");
        let mut e: i32 = 0 - 1;
        if p.err == "" {
            (p, e) = parse_expr(p, 1);
        }
        let mut fi: i32 = 0 - 1;
        if p.err == "" {
            (p, fi) = add_node(p, 31, e, 0 - 1, 0 - 1, 0, f.word, f.pos, []);
            kids = push(kids, fi);
        }
        if p.err == "" && p.toks[p.i].kind == 27 {
            p = p with { i: p.i + 1 };
        } else if p.err == "" && p.toks[p.i].kind != 23 {
            p = fail_cat(p, "syntax", "expected ',' or '}'");
        }
    }
    p = expect(p, 23, "'}'");
    return (p, kids);
}

// comma-separated expressions up to `close`
fn parse_expr_list(p0: P, close: i32, what: text) -> (P, Sequence(i32)) {
    let mut p: P = p0;
    let mut kids: Sequence(i32) = [];
    if p.toks[p.i].kind != close {
        let mut more: bool = true;
        while more && p.err == "" {
            let mut e: i32 = 0 - 1;
            (p, e) = parse_expr(p, 1);
            kids = push(kids, e);
            if p.err == "" && p.toks[p.i].kind == 27 {
                p = p with { i: p.i + 1 };
            } else {
                more = false;
            }
        }
    }
    p = expect(p, close, what);
    return (p, kids);
}

// A block whose last item may be a value expression without ';' (BlockExpr).
fn parse_block_expr(p0: P) -> (P, i32) {
    let open: Tok = p0.toks[p0.i];
    let mut p: P = expect(p0, 22, "'{'");
    let mut kids: Sequence(i32) = [];
    let mut tail: i32 = 0 - 1;
    while p.err == "" && p.toks[p.i].kind != 23 && tail < 0 {
        let k: i32 = p.toks[p.i].kind;
        if k == 0 {
            p = fail_cat(p, "syntax", "expected '}'");
        } else if k == 12 {
            let mut trial: P = p;
            let mut e: i32 = 0 - 1;
            (trial, e) = parse_expr(trial, 1);
            if trial.err == "" && trial.toks[trial.i].kind == 23 {
                p = trial;
                tail = e;
            } else if trial.err == "" && trial.toks[trial.i].kind == 24 {
                p = trial with { i: trial.i + 1 };
                let mut s: i32 = 0 - 1;
                (p, s) = add_node(p, 16, e, 0 - 1, 0 - 1, 0, "", open.pos, []);
                kids = push(kids, s);
            } else {
                let mut statement: P = p;
                let mut s: i32 = 0 - 1;
                (statement, s) = parse_if(statement);
                if statement.err == "" {
                    p = statement;
                    kids = push(kids, s);
                } else {
                    p = trial;
                    if p.err == "" { p = fail_cat(p, "syntax", "expected ';' or '}' after if expression"); }
                }
            }
        } else if k == 3 || k == 6 || k == 7 || k == 14 || k == 16 || k == 17 || k == 19 || k == 15 || k == 18 {
            let mut s: i32 = 0 - 1;
            (p, s) = parse_stmt(p);
            kids = push(kids, s);
        } else if k == 2 && kind_at(p, 1) == 26 {
            let mut s: i32 = 0 - 1;
            (p, s) = parse_stmt(p);
            kids = push(kids, s);
        } else {
            let mut e: i32 = 0 - 1;
            (p, e) = parse_expr(p, 1);
            // `&&` is not short-circuit: index the node only when it exists
            let is_match: bool = if e >= 0 { p.nodes[e].k == 25 } else { false };
            if p.err == "" && p.toks[p.i].kind == 24 {
                p = p with { i: p.i + 1 };
                let mut s: i32 = 0 - 1;
                (p, s) = add_node(p, 16, e, 0 - 1, 0 - 1, 0, "", open.pos, []);
                kids = push(kids, s);
            } else if p.err == "" && is_match {
                // a match used as a statement needs no ';'
                if p.toks[p.i].kind == 23 {
                    tail = e;
                } else {
                    let mut s: i32 = 0 - 1;
                    (p, s) = add_node(p, 16, e, 0 - 1, 0 - 1, 0, "", open.pos, []);
                    kids = push(kids, s);
                }
            } else {
                tail = e;
            }
        }
    }
    p = expect(p, 23, "'}'");
    if p.err != "" { return (p, 0 - 1); }
    return add_node(p, 27, tail, 0 - 1, 0 - 1, 0, "", open.pos, kids);
}

// value-producing `if`: if cond blockexpr else (blockexpr | if)
fn parse_if_expr(p0: P) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    let mut p: P = p0 with { i: p0.i + 1 };
    let mut cond: i32 = 0 - 1;
    (p, cond) = parse_expr(p, 1);
    let mut thenb: i32 = 0 - 1;
    (p, thenb) = parse_block_expr(p);
    let mut elseb: i32 = 0 - 1;
    if p.err == "" && p.toks[p.i].kind == 13 {
        p = p with { i: p.i + 1 };
        if p.toks[p.i].kind == 12 {
            (p, elseb) = parse_if_expr(p);
        } else {
            (p, elseb) = parse_block_expr(p);
        }
    } else {
        p = fail_cat(p, "syntax", "a value-producing 'if' needs an 'else' branch");
    }
    if p.err != "" { return (p, 0 - 1); }
    return add_node(p, 26, cond, thenb, elseb, 0, "", t.pos, []);
}

// match scrutinee { pattern => expr-or-block [,] ... }
fn parse_match(p0: P) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    let mut p: P = p0 with { i: p0.i + 1 };
    let mut scrut: i32 = 0 - 1;
    (p, scrut) = parse_expr(p, 1);
    p = expect(p, 22, "'{'");
    let mut arms: Sequence(i32) = [];
    while p.err == "" && p.toks[p.i].kind != 23 {
        let pt: Tok = p.toks[p.i];
        let mut kind: i32 = 0;
        let mut lit: i32 = 0;
        let mut bind: text = "";
        if pt.kind == 2 && pt.word == "_" {
            p = p with { i: p.i + 1 };
        } else if pt.kind == 1 {
            kind = 1;
            lit = pt.num;
            p = p with { i: p.i + 1 };
        } else if pt.kind == 45 {
            kind = 2;
            lit = pt.num;
            p = p with { i: p.i + 1 };
        } else if pt.kind == 2 && pt.word == "Option" && kind_at(p, 1) == 49 {
            p = p with { i: p.i + 2 };
            let vt: Tok = p.toks[p.i];
            p = expect(p, 2, "variant name");
            if vt.word == "Some" {
                kind = 3;
                p = expect(p, 20, "'('");
                let bt: Tok = p.toks[p.i];
                p = expect(p, 2, "binding name");
                bind = bt.word;
                p = expect(p, 21, "')'");
            } else if vt.word == "None" {
                kind = 4;
            } else if p.err == "" {
                p = fail_cat(p, "syntax", "unknown Option variant '" + vt.word + "'");
            }
        } else {
            p = fail_cat(p, "unsupported", "this match pattern is outside the supported subset");
        }
        if p.err == "" && p.toks[p.i].kind == 12 {
            p = fail_cat(p, "unsupported", "match guards are outside the supported subset");
        }
        p = expect(p, 50, "'=>'");
        let mut body: i32 = 0 - 1;
        if p.err == "" {
            if p.toks[p.i].kind == 22 {
                (p, body) = parse_block_expr(p);
            } else {
                (p, body) = parse_expr(p, 1);
            }
        }
        let mut arm: i32 = 0 - 1;
        if p.err == "" {
            (p, arm) = add_node(p, 32, body, lit, 0 - 1, kind, bind, pt.pos, []);
            arms = push(arms, arm);
        }
        if p.err == "" && p.toks[p.i].kind == 27 {
            p = p with { i: p.i + 1 };
        }
    }
    p = expect(p, 23, "'}'");
    if p.err != "" { return (p, 0 - 1); }
    return add_node(p, 25, scrut, 0 - 1, 0 - 1, 0, "", t.pos, arms);
}

fn parse_primary(p0: P) -> (P, i32) {
    let mut p: P = p0;
    let t: Tok = p.toks[p.i];
    if t.kind == 22 {
        return parse_block_expr(p);
    }
    if t.kind == 1 {
        return add_node(p with { i: p.i + 1 }, 1, 0 - 1, 0 - 1, 0 - 1, t.num, "", t.pos, []);
    }
    if t.kind == 45 {
        return add_node(p with { i: p.i + 1 }, 8, 0 - 1, 0 - 1, 0 - 1, t.num, "", t.pos, []);
    }
    if t.kind == 44 {
        return add_node(p with { i: p.i + 1 }, 3, 0 - 1, 0 - 1, 0 - 1, 0, t.word, t.pos, []);
    }
    if t.kind == 8 || t.kind == 9 {
        let v: i32 = if t.kind == 8 { 1 } else { 0 };
        return add_node(p with { i: p.i + 1 }, 2, 0 - 1, 0 - 1, 0 - 1, v, "", t.pos, []);
    }
    if t.kind == 52 {
        return parse_match(p);
    }
    if t.kind == 12 {
        return parse_if_expr(p);
    }
    if t.kind == 2 {
        let k1: i32 = kind_at(p, 1);
        if k1 == 20 {
            p = p with { i: p.i + 2 };
            let mut args: Sequence(i32) = [];
            (p, args) = parse_expr_list(p, 21, "')'");
            if p.err != "" { return (p, 0 - 1); }
            return add_node(p, 7, 0 - 1, 0 - 1, 0 - 1, 0, t.word, t.pos, args);
        }
        if k1 == 22 && kind_at(p, 2) == 2 && kind_at(p, 3) == 25 {
            // record literal: Name { field: expr, ... }
            p = p with { i: p.i + 1 };
            let mut fields: Sequence(i32) = [];
            (p, fields) = parse_field_inits(p);
            if p.err != "" { return (p, 0 - 1); }
            return add_node(p, 29, 0 - 1, 0 - 1, 0 - 1, 0, t.word, t.pos, fields);
        }
        if k1 == 49 {
            return (fail_cat(p, "unsupported", "path expressions ('" + t.word + "::...') are outside the supported subset"), 0 - 1);
        }
        return add_node(p with { i: p.i + 1 }, 4, 0 - 1, 0 - 1, 0 - 1, 0, t.word, t.pos, []);
    }
    if t.kind == 20 {
        p = p with { i: p.i + 1 };
        if p.toks[p.i].kind == 21 {
            return (fail_cat(p, "unsupported", "unit expressions are outside the supported subset"), 0 - 1);
        }
        let mut e: i32 = 0 - 1;
        (p, e) = parse_expr(p, 1);
        if p.err == "" && p.toks[p.i].kind == 27 {
            // tuple literal
            let mut items: Sequence(i32) = [e];
            p = p with { i: p.i + 1 };
            let mut rest: Sequence(i32) = [];
            (p, rest) = parse_expr_list(p, 21, "')'");
            for r in rest {
                items = push(items, r);
            }
            if p.err != "" { return (p, 0 - 1); }
            return add_node(p, 22, 0 - 1, 0 - 1, 0 - 1, 0, "", t.pos, items);
        }
        p = expect(p, 21, "')'");
        return (p, e);
    }
    if t.kind == 47 {
        p = p with { i: p.i + 1 };
        let mut items: Sequence(i32) = [];
        (p, items) = parse_expr_list(p, 48, "']'");
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 23, 0 - 1, 0 - 1, 0 - 1, 0, "", t.pos, items);
    }
    return (fail_cat(p, "syntax", "expected expression"), 0 - 1);
}

// primary { "." field | "[" expr "]" | "with" field-inits }
fn parse_postfix(p0: P) -> (P, i32) {
    let mut p: P = p0;
    let mut e: i32 = 0 - 1;
    (p, e) = parse_primary(p);
    let mut more: bool = true;
    while more && p.err == "" {
        let t: Tok = p.toks[p.i];
        if t.kind == 46 && kind_at(p, 1) == 46 {
            p = fail_cat(p, "unsupported", "ranges are outside the supported subset");
        } else if t.kind == 46 {
            p = p with { i: p.i + 1 };
            let f: Tok = p.toks[p.i];
            if f.kind == 1 {
                p = fail_cat(p, "unsupported", "tuple field access is outside the supported subset");
            }
            p = expect(p, 2, "field name");
            if p.err == "" && p.toks[p.i].kind == 20 {
                p = fail_cat(p, "unsupported", "method calls are outside the supported subset");
            }
            if p.err == "" {
                (p, e) = add_node(p, 20, e, 0 - 1, 0 - 1, 0, f.word, f.pos, []);
            }
        } else if t.kind == 47 {
            p = p with { i: p.i + 1 };
            let mut ix: i32 = 0 - 1;
            (p, ix) = parse_expr(p, 1);
            p = expect(p, 48, "']'");
            if p.err == "" {
                (p, e) = add_node(p, 24, e, ix, 0 - 1, 0, "", t.pos, []);
            }
        } else if t.kind == 53 {
            p = p with { i: p.i + 1 };
            let mut fields: Sequence(i32) = [];
            (p, fields) = parse_field_inits(p);
            if p.err == "" {
                (p, e) = add_node(p, 21, e, 0 - 1, 0 - 1, 0, "", t.pos, fields);
            }
        } else {
            more = false;
        }
    }
    return (p, e);
}

fn parse_unary(p0: P) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    if t.kind == 31 || t.kind == 43 {
        let mut p: P = p0 with { i: p0.i + 1 };
        let mut e: i32 = 0 - 1;
        (p, e) = parse_unary(p);
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 5, e, 0 - 1, 0 - 1, t.kind, "", t.pos, []);
    }
    return parse_postfix(p0);
}

// Precedence climbing; every binary operator is left-associative.
fn parse_expr(p0: P, minp: i32) -> (P, i32) {
    let mut p: P = p0;
    let mut lhs: i32 = 0 - 1;
    (p, lhs) = parse_unary(p);
    while p.err == "" {
        let t: Tok = p.toks[p.i];
        let pr: i32 = prec(t.kind);
        if pr == 0 || pr < minp {
            break;
        }
        p = p with { i: p.i + 1 };
        let mut rhs: i32 = 0 - 1;
        (p, rhs) = parse_expr(p, pr + 1);
        if p.err != "" { break; }
        (p, lhs) = add_node(p, 6, lhs, rhs, 0 - 1, t.kind, "", t.pos, []);
    }
    return (p, lhs);
}

fn parse_block(p0: P) -> (P, i32) {
    let open: Tok = p0.toks[p0.i];
    let mut p: P = expect(p0, 22, "'{'");
    let mut kids: Sequence(i32) = [];
    while p.err == "" && p.toks[p.i].kind != 23 {
        if p.toks[p.i].kind == 0 {
            p = fail_cat(p, "syntax", "expected '}'");
        } else {
            let mut s: i32 = 0 - 1;
            (p, s) = parse_stmt(p);
            kids = push(kids, s);
        }
    }
    p = expect(p, 23, "'}'");
    if p.err != "" { return (p, 0 - 1); }
    return add_node(p, 15, 0 - 1, 0 - 1, 0 - 1, 0, "", open.pos, kids);
}

fn parse_if(p0: P) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    let mut p: P = p0 with { i: p0.i + 1 };
    let mut cond: i32 = 0 - 1;
    (p, cond) = parse_expr(p, 1);
    let mut thenb: i32 = 0 - 1;
    (p, thenb) = parse_block(p);
    let mut elseb: i32 = 0 - 1;
    if p.err == "" && p.toks[p.i].kind == 13 {
        p = p with { i: p.i + 1 };
        if p.toks[p.i].kind == 12 {
            (p, elseb) = parse_if(p);
        } else {
            (p, elseb) = parse_block(p);
        }
    }
    if p.err != "" { return (p, 0 - 1); }
    return add_node(p, 12, cond, thenb, elseb, 0, "", t.pos, []);
}

// "(" name {"," name} ")"  ->  Name nodes
fn parse_name_list(p0: P) -> (P, Sequence(i32)) {
    let mut p: P = expect(p0, 20, "'('");
    let mut names: Sequence(i32) = [];
    let mut more: bool = true;
    while more && p.err == "" {
        let t: Tok = p.toks[p.i];
        p = expect(p, 2, "name");
        let mut nd: i32 = 0 - 1;
        if p.err == "" {
            (p, nd) = add_node(p, 33, 0 - 1, 0 - 1, 0 - 1, 0, t.word, t.pos, []);
            names = push(names, nd);
        }
        if p.err == "" && p.toks[p.i].kind == 27 {
            p = p with { i: p.i + 1 };
        } else {
            more = false;
        }
    }
    p = expect(p, 21, "')'");
    return (p, names);
}

fn parse_stmt(p0: P) -> (P, i32) {
    let t: Tok = p0.toks[p0.i];
    let mut p: P = p0;
    let mut e: i32 = 0 - 1;
    if t.kind == 3 {
        p = p with { i: p.i + 1 };
        let mut is_mut: i32 = 0;
        if p.toks[p.i].kind == 4 {
            is_mut = 1;
            p = p with { i: p.i + 1 };
        }
        if p.toks[p.i].kind == 20 {
            let mut names: Sequence(i32) = [];
            (p, names) = parse_name_list(p);
            let mut ty: i32 = 0 - 1;
            if p.err == "" && p.toks[p.i].kind == 25 {
                (p, ty) = parse_type(p with { i: p.i + 1 });
            }
            p = expect(p, 26, "'='");
            if p.err != "" { return (p, 0 - 1); }
            (p, e) = parse_expr(p, 1);
            p = expect(p, 24, "';'");
            if p.err != "" { return (p, 0 - 1); }
            return add_node(p, 40, e, 0 - 1, is_mut, ty, "", t.pos, names);
        }
        let id: Tok = p.toks[p.i];
        p = expect(p, 2, "variable name");
        let mut ty: i32 = 0 - 1;
        if p.err == "" && p.toks[p.i].kind == 25 {
            (p, ty) = parse_type(p with { i: p.i + 1 });
        }
        p = expect(p, 26, "'='");
        if p.err != "" { return (p, 0 - 1); }
        (p, e) = parse_expr(p, 1);
        p = expect(p, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 10, e, 0 - 1, is_mut, ty, id.word, id.pos, []);
    }
    if t.kind == 2 && kind_at(p, 1) == 26 {
        p = p with { i: p.i + 2 };
        (p, e) = parse_expr(p, 1);
        p = expect(p, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 11, e, 0 - 1, 0 - 1, 0, t.word, t.pos, []);
    }
    if t.kind == 2 && kind_at(p, 2) == 26 {
        let op: i32 = kind_at(p, 1);
        if op >= 30 && op <= 34 {
            return (fail_cat(p with { i: p.i + 1 }, "unsupported", "compound assignment is outside the supported subset"), 0 - 1);
        }
    }
    if t.kind == 20 && kind_at(p, 1) == 2 && kind_at(p, 2) == 27 {
        // (a, b) = expr;
        let mut names: Sequence(i32) = [];
        (p, names) = parse_name_list(p);
        p = expect(p, 26, "'='");
        if p.err != "" { return (p, 0 - 1); }
        (p, e) = parse_expr(p, 1);
        p = expect(p, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 41, e, 0 - 1, 0 - 1, 0, "", t.pos, names);
    }
    if t.kind == 6 {
        p = expect(p with { i: p.i + 1 }, 20, "'('");
        if p.err != "" { return (p, 0 - 1); }
        (p, e) = parse_expr(p, 1);
        p = expect(p, 21, "')'");
        p = expect(p, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 17, e, 0 - 1, 0 - 1, 0, "", t.pos, []);
    }
    if t.kind == 7 {
        p = p with { i: p.i + 1 };
        if p.toks[p.i].kind == 24 {
            return add_node(p with { i: p.i + 1 }, 14, 0 - 1, 0 - 1, 0 - 1, 0, "", t.pos, []);
        }
        (p, e) = parse_expr(p, 1);
        p = expect(p, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 14, e, 0 - 1, 0 - 1, 0, "", t.pos, []);
    }
    if t.kind == 12 {
        return parse_if(p);
    }
    if t.kind == 14 {
        p = p with { i: p.i + 1 };
        let mut cond: i32 = 0 - 1;
        (p, cond) = parse_expr(p, 1);
        let mut body: i32 = 0 - 1;
        (p, body) = parse_block(p);
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 13, cond, body, 0 - 1, 0, "", t.pos, []);
    }
    if t.kind == 19 {
        // for name in sequence-expression { ... }
        p = p with { i: p.i + 1 };
        let nt: Tok = p.toks[p.i];
        p = expect(p, 2, "loop variable");
        p = expect(p, 56, "'in'");
        if p.err != "" { return (p, 0 - 1); }
        (p, e) = parse_expr(p, 1);
        if p.err == "" && p.toks[p.i].kind == 46 {
            return (fail_cat(p, "unsupported", "range loops are outside the supported subset"), 0 - 1);
        }
        let mut body: i32 = 0 - 1;
        (p, body) = parse_block(p);
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 42, e, body, 0 - 1, 0, nt.word, t.pos, []);
    }
    if t.kind == 16 || t.kind == 17 {
        p = expect(p with { i: p.i + 1 }, 24, "';'");
        if p.err != "" { return (p, 0 - 1); }
        let k: i32 = if t.kind == 16 { 18 } else { 19 };
        return add_node(p, k, 0 - 1, 0 - 1, 0 - 1, 0, "", t.pos, []);
    }
    if t.kind == 15 || t.kind == 18 {
        return (fail_cat(p, "unsupported", "'" + t.word + "' is outside the supported subset"), 0 - 1);
    }
    if t.kind == 22 {
        return (fail_cat(p, "unsupported", "a bare block is a value-producing block expression in Semantic; outside the subset"), 0 - 1);
    }
    if t.kind == 52 {
        // match statement: arms produce unit; no ';' needed
        (p, e) = parse_match(p);
        if p.err == "" && p.toks[p.i].kind == 24 {
            p = p with { i: p.i + 1 };
        }
        if p.err != "" { return (p, 0 - 1); }
        return add_node(p, 16, e, 0 - 1, 0 - 1, 0, "", t.pos, []);
    }
    (p, e) = parse_expr(p, 1);
    p = expect(p, 24, "';'");
    if p.err != "" { return (p, 0 - 1); }
    return add_node(p, 16, e, 0 - 1, 0 - 1, 0, "", t.pos, []);
}

// fn name(param: type, ...) [-> type] block
fn parse_func(p0: P) -> P {
    let fn_tok: Tok = p0.toks[p0.i];
    let mut p: P = p0 with { i: p0.i + 1 };
    let name: Tok = p.toks[p.i];
    p = expect(p, 2, "function name");
    p = expect(p, 20, "'('");
    let mut pnames: Sequence(text) = [];
    let mut ptypes: Sequence(i32) = [];
    if p.err == "" && p.toks[p.i].kind != 21 {
        let mut more: bool = true;
        while more && p.err == "" {
            let pn: Tok = p.toks[p.i];
            p = expect(p, 2, "parameter name");
            p = expect(p, 25, "':'");
            let mut pt: i32 = 0 - 1;
            if p.err == "" {
                (p, pt) = parse_type(p);
            }
            if p.err == "" && p.toks[p.i].kind == 26 {
                p = fail_cat(p, "unsupported", "default parameters are outside the supported subset");
            }
            pnames = push(pnames, pn.word);
            ptypes = push(ptypes, pt);
            if p.err == "" && p.toks[p.i].kind == 27 {
                p = p with { i: p.i + 1 };
            } else {
                more = false;
            }
        }
    }
    p = expect(p, 21, "')'");
    let mut ret: i32 = 0 - 1;
    if p.err == "" && p.toks[p.i].kind == 28 {
        (p, ret) = parse_type(p with { i: p.i + 1 });
    }
    if p.err == "" && p.toks[p.i].kind == 2 {
        let w: text = p.toks[p.i].word;
        if w == "requires" || w == "ensures" || w == "invariant" {
            return fail_cat(p, "unsupported", "function contracts are outside the supported subset");
        }
    }
    if p.err == "" && p.toks[p.i].kind == 26 {
        return fail_cat(p, "unsupported", "expression-bodied functions are outside the supported subset");
    }
    let mut body: i32 = 0 - 1;
    (p, body) = parse_block(p);
    if p.err != "" { return p; }
    let f: Func = Func { name: name.word, pnames: pnames, ptypes: ptypes, ret: ret, body: body, pos: fn_tok.pos };
    return p with { funcs: push(p.funcs, f) };
}

// record Name { field: type, ... }
fn parse_record(p0: P) -> P {
    let rt: Tok = p0.toks[p0.i];
    let mut p: P = p0 with { i: p0.i + 1 };
    let name: Tok = p.toks[p.i];
    p = expect(p, 2, "record name");
    p = expect(p, 22, "'{'");
    let mut fnames: Sequence(text) = [];
    let mut ftypes: Sequence(i32) = [];
    while p.err == "" && p.toks[p.i].kind != 23 {
        let f: Tok = p.toks[p.i];
        p = expect(p, 2, "field name");
        p = expect(p, 25, "':'");
        let mut ft: i32 = 0 - 1;
        if p.err == "" {
            (p, ft) = parse_type(p);
        }
        fnames = push(fnames, f.word);
        ftypes = push(ftypes, ft);
        if p.err == "" && p.toks[p.i].kind == 27 {
            p = p with { i: p.i + 1 };
        } else if p.err == "" && p.toks[p.i].kind != 23 {
            p = fail_cat(p, "syntax", "expected ',' or '}'");
        }
    }
    p = expect(p, 23, "'}'");
    if p.err != "" { return p; }
    if len(fnames) == 0 {
        return p with { err: "record declarations must be non-empty", cat: "type", errpos: rt.pos };
    }
    return p with { recs: push(p.recs, Rec { name: name.word, fnames: fnames, ftypes: ftypes, pos: rt.pos }) };
}

fn parse_program(toks: Sequence(Tok)) -> P {
    let mut p: P = P { toks: toks, i: 0, nodes: [], funcs: [], recs: [], err: "", cat: "", errpos: 0u32 };
    while p.err == "" && p.toks[p.i].kind != 0 {
        let t: Tok = p.toks[p.i];
        if t.kind == 5 {
            p = parse_func(p);
        } else if t.kind == 51 {
            p = parse_record(p);
        } else if t.kind == 2 {
            p = fail_cat(p, "unsupported", "top-level item '" + t.word + "' is outside the supported subset (only functions and records)");
        } else {
            p = fail_cat(p, "syntax", "expected 'fn'");
        }
    }
    return p;
}
