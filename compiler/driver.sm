// driver: source text -> one result line.
//   "hex <lowercase hex of the SemCode artifact>"
//   "error <syntax|name|type|context|unsupported> @<byte offset>: <message>"
Import "semcode.sm"

fn compile_source(src: text) -> text {
    let lx: Lexed = lex(src);
    if lx.err != "" {
        return "error " + lx.cat + " @" + to_text(lx.errpos) + ": " + lx.err;
    }
    let p: P = parse_program(lx.toks);
    if p.err != "" {
        return "error " + p.cat + " @" + to_text(p.errpos) + ": " + p.err;
    }
    let sem: Sem = analyze(Prog { nodes: p.nodes, funcs: p.funcs, recs: p.recs });
    if sem.err != "" {
        return "error " + sem.cat + " @" + to_text(sem.errpos) + ": " + sem.err;
    }
    let mut fns: Sequence(FnIr) = [];
    let mut i: i32 = 0;
    while i < len(sem.prog.funcs) {
        fns = push(fns, lower_function(sem, i));
        i = i + 1;
    }
    let (artifact, encoding_error) = encode_program(fns, sem.u32arith);
    if encoding_error != "" {
        return "error unsupported @0: " + encoding_error;
    }
    return "hex " + join_hex(artifact);
}
