// semcode: canonical SemCode encoder for the emitted subset.
Import "bytes.sm"
Import "lower.sm"

// Caches only low values; all other valid u16 operands serialize as
// full little-endian 16-bit numbers without indexing beyond the cache.
fn encode_u16_le(hx: Sequence(text), cache: Sequence(text), value: i32) -> text {
    if value >= 0 && value < len(cache) { return cache[value]; }
    return hx[value % 256] + hx[(value / 256) % 256];
}

// Jumps and OWN0 anchors are 32-bit little-endian addresses.
// Using the same conversion at each site prevents accidental truncation.
fn encode_u32_le(hx: Sequence(text), cache: Sequence(text), value: i32) -> text {
    return encode_u16_le(hx, cache, value % 65536) +
           encode_u16_le(hx, cache, value / 65536);
}

fn encode_function(hx: Sequence(text), u16: Sequence(text), b_hex: Map(u32, text), f: FnIr, art0: Sequence(text)) -> (Sequence(text), text) {
    let fnn: u32 = text_len(f.name);
    if fnn > 1024u32 {
        return ([], "SemCode function name exceeds 1024 UTF-8 bytes");
    }
    let ns: i32 = len(f.strings);
    if ns > 256 {
        return ([], "SemCode string table exceeds 256 entries");
    }
    let mut offsets: Map(i32, i32) = map_empty();
    let has_owns: bool = len(f.owns) > 0;
    let mut anchor_pcs: Sequence(i32) = [];
    let mut pc: i32 = 0;
    for i in f.ins {
        let op: i32 = i.op;
        if has_owns {
            anchor_pcs = push(anchor_pcs, pc);
        }
        if op < 48 {
            if op >= 4 {
                if op <= 5 { pc = pc + 5; }
                else if op == 22 || op == 18 { pc = pc + 5; }
                else { pc = pc + 7; }
            } else if op == 3 { pc = pc + 7; }
            else if op == 1 || op == 2 { pc = pc + 4; }
            else { offsets = map_set(offsets, i.imm, pc); }
        } else if op == 70 { pc = pc + 9; }
        else if op == 64 { pc = pc + 8 + 2 * len(i.args); }
        else if op == 48 { pc = pc + 5; }
        else if op == 49 { pc = pc + 7; }
        else if op == 90 || op == 95 || op == 107 { pc = pc + 5; }
        else if op == 69 { pc = pc + 7 + 2 * len(i.args); }
        else if op == 65 {
            if i.a == 1 { pc = pc + 4; } else { pc = pc + 2; }
        } else if op == 67 || op == 91 { pc = pc + 5 + 2 * len(i.args); }
        else if op == 73 || op == 114 || op == 115 { pc = pc + 9; }
        else if op == 66 || op == 112 { pc = pc + 3; }
        else { pc = pc + 7; }
    }
    let mut hdr: text = encode_u16_le(hx, u16, ns);
    let mut hdr_len: i32 = 2;
    let mut hdr_chunks: Sequence(text) = [];
    for s in f.strings {
        let sn: u32 = text_len(s);
        if sn > 1024u32 {
            return ([], "SemCode string entry exceeds 1024 UTF-8 bytes");
        }
        let mut si: u32 = 0u32;
        let mut slen: i32 = 0;
        let mut sh: text = "";
        while true {
            let b: u32 = match text_byte_at(s, si) {
                Option::Some(x) => { x }
                Option::None => { 256u32 }
            };
            if b == 256u32 { break; }
            sh = sh + map_get(b_hex, b, "00");
            si = si + 1u32;
            slen = slen + 1;
        }
        hdr = hdr + encode_u16_le(hx, u16, slen) + sh;
        hdr_len = hdr_len + 2 + slen;
        if text_len(hdr) >= 512u32 {
            hdr_chunks = push(hdr_chunks, hdr);
            hdr = "";
        }
    }
    let n_owns: i32 = len(f.owns);
    hdr = hdr + "4f574e30" + encode_u16_le(hx, u16, n_owns);
    hdr_len = hdr_len + 6;
    let n_ins: i32 = len(f.ins);
    for ev in f.owns {
        if ev.anchor < 0 || ev.anchor >= n_ins {
            return ([], "ownership event references a missing instruction anchor");
        }
        let target_op: i32 = f.ins[ev.anchor].op;
        if target_op == 0 - 1 {
            return ([], "ownership event references a missing instruction anchor");
        }
        if ev.mode == 0 && target_op != 5 {
            return ([], "ownership StoreVarSite anchor does not target StoreVar");
        }
        if ev.mode == 1 && target_op != 69 {
            return ([], "ownership MakeRecordSite anchor does not target MakeRecord");
        }
        let ck: i32 = if ev.comp_kind < 0 { 0 } else { 1 };
        let apc: i32 = anchor_pcs[ev.anchor];
        hdr = hdr + hx[ev.kind] + hx[ev.mode] + encode_u32_le(hx, u16, apc) + encode_u16_le(hx, u16, ev.root) + "0000" + encode_u16_le(hx, u16, ck);
        hdr_len = hdr_len + 12;
        if ev.comp_kind >= 0 {
            hdr = hdr + hx[ev.comp_kind];
            hdr_len = hdr_len + 1;
            let ca: i32 = ev.comp_a;
            if ev.comp_kind == 0 {
                hdr = hdr + encode_u16_le(hx, u16, ca);
                hdr_len = hdr_len + 2;
            } else if ev.comp_kind == 2 {
                hdr = hdr + encode_u16_le(hx, u16, ca) + "0000" + encode_u16_le(hx, u16, ev.comp_b);
                hdr_len = hdr_len + 6;
            } else {
                hdr = hdr + encode_u16_le(hx, u16, ca) + "0000";
                hdr_len = hdr_len + 4;
            }
        }
    }
    let n_fam: i32 = len(f.families);
    hdr = hdr + "53494730" + encode_u16_le(hx, u16, n_fam);
    hdr_len = hdr_len + 6 + n_fam;
    for fam in f.families {
        hdr = hdr + hx[fam];
    }
    hdr_chunks = push(hdr_chunks, hdr);

    let mut fni: u32 = 0u32;
    let mut fn_len: i32 = 0;
    let mut fn_hex: text = "";
    while true {
        let b: u32 = match text_byte_at(f.name, fni) {
            Option::Some(x) => { x }
            Option::None => { 256u32 }
        };
        if b == 256u32 { break; }
        fn_hex = fn_hex + map_get(b_hex, b, "00");
        fni = fni + 1u32;
        fn_len = fn_len + 1;
    }
    let code_len: i32 = hdr_len + pc;
    let mut art: Sequence(text) = push(art0, encode_u16_le(hx, u16, fn_len) + fn_hex + encode_u32_le(hx, u16, code_len));
    for hc in hdr_chunks {
        art = push(art, hc);
    }

    let mut chunk: text = "";
    let mut c_count: i32 = 0;
    for i in f.ins {
        let op: i32 = i.op;
        if op >= 0 {
            if op < 48 {
                if op <= 6 {
                    if op == 4 || op == 5 {
                        chunk = chunk + hx[op] + encode_u16_le(hx, u16, i.a) + encode_u16_le(hx, u16, i.b);
                    } else if op == 1 {
                        chunk = chunk + "01" + encode_u16_le(hx, u16, i.a) + hx[i.imm];
                    } else if op == 2 {
                        chunk = chunk + "02" + encode_u16_le(hx, u16, i.a) + hx[i.imm];
                    } else {
                        let v: i32 = i.imm;
                        let mut vhex: text = "ffffffff";
                        if v >= 0 {
                            vhex = encode_u32_le(hx, u16, v);
                        } else if v != 0 - 1 {
                            let b0: i32 = ((v % 256) + 256) % 256;
                            let v1: i32 = (v - b0) / 256;
                            let b1: i32 = ((v1 % 256) + 256) % 256;
                            let v2: i32 = (v1 - b1) / 256;
                            let b2: i32 = ((v2 % 256) + 256) % 256;
                            let v3: i32 = (v2 - b2) / 256;
                            let b3: i32 = ((v3 % 256) + 256) % 256;
                            vhex = hx[b0] + hx[b1] + hx[b2] + hx[b3];
                        }
                        chunk = chunk + hx[op] + encode_u16_le(hx, u16, i.a) + vhex;
                    }
                } else if op == 22 || op == 18 {
                    chunk = chunk + hx[op] + encode_u16_le(hx, u16, i.a) + encode_u16_le(hx, u16, i.b);
                } else {
                    chunk = chunk + hx[op] + encode_u16_le(hx, u16, i.a) + encode_u16_le(hx, u16, i.b) + encode_u16_le(hx, u16, i.c);
                }
            } else if op == 70 || op == 73 || op == 114 || op == 115 {
                chunk = chunk + hx[op] + encode_u16_le(hx, u16, i.a) + encode_u16_le(hx, u16, i.b) + encode_u16_le(hx, u16, i.c) + encode_u16_le(hx, u16, i.imm);
            } else if op == 64 {
                let argc: i32 = len(i.args);
                chunk = chunk + "40" + hx[i.a] + encode_u16_le(hx, u16, i.b) + encode_u16_le(hx, u16, i.c) + encode_u16_le(hx, u16, argc);
                for r in i.args {
                    chunk = chunk + encode_u16_le(hx, u16, r);
                }
            } else if op == 48 {
                let v: i32 = map_get(offsets, i.imm, 0);
                chunk = chunk + "30" + encode_u32_le(hx, u16, v);
            } else if op == 49 {
                let v: i32 = map_get(offsets, i.imm, 0);
                chunk = chunk + "31" + encode_u16_le(hx, u16, i.a) + encode_u32_le(hx, u16, v);
            } else if op == 90 || op == 95 || op == 107 {
                chunk = chunk + hx[op] + encode_u16_le(hx, u16, i.a) + encode_u16_le(hx, u16, i.b);
            } else if op == 69 {
                let cnt: i32 = len(i.args);
                chunk = chunk + "45" + encode_u16_le(hx, u16, i.a) + encode_u16_le(hx, u16, i.b) + encode_u16_le(hx, u16, cnt);
                for r in i.args { chunk = chunk + encode_u16_le(hx, u16, r); }
            } else if op == 65 {
                if i.a == 1 {
                    chunk = chunk + "4101" + encode_u16_le(hx, u16, i.b);
                } else {
                    chunk = chunk + "4100";
                }
            } else if op == 67 || op == 91 {
                let cnt: i32 = len(i.args);
                chunk = chunk + hx[op] + encode_u16_le(hx, u16, i.a) + encode_u16_le(hx, u16, cnt);
                for r in i.args { chunk = chunk + encode_u16_le(hx, u16, r); }
            } else if op == 68 {
                chunk = chunk + "44" + encode_u16_le(hx, u16, i.a) + encode_u16_le(hx, u16, i.b) + encode_u16_le(hx, u16, i.imm);
            } else if op == 66 || op == 112 {
                chunk = chunk + hx[op] + encode_u16_le(hx, u16, i.a);
            } else {
                chunk = chunk + hx[op] + encode_u16_le(hx, u16, i.a) + encode_u16_le(hx, u16, i.b) + encode_u16_le(hx, u16, i.c);
            }
            c_count = c_count + 1;
            if c_count == 24 {
                art = push(art, chunk);
                chunk = "";
                c_count = 0;
            }
        }
    }
    if chunk != "" {
        art = push(art, chunk);
    }
    return (art, "");
}

fn encode_program(fns: Sequence(FnIr), u32arith: bool) -> (Sequence(text), text) {
    let hx: Sequence(text) = hex_table();
    let mut b_hex: Map(u32, text) = map_empty();
    let mut bi: i32 = 0;
    let mut bu: u32 = 0u32;
    while bi < 256 {
        b_hex = map_set(b_hex, bu, hx[bi]);
        bi = bi + 1;
        bu = bu + 1u32;
    }
    let mut u16: Sequence(text) = [];
    for hi in ["00", "01", "02", "03", "04", "05", "06", "07", "08", "09", "0a", "0b", "0c"] {
        for lo in hx {
            u16 = push(u16, lo + hi);
        }
    }
    let header_hex: text = if u32arith { "53454d434f443233" } else { "53454d434f443232" };
    let adt_hex: text = "41445430020006004f7074696f6e020004004e6f6e6500000400536f6d6501000600526573756c74020002004f6b010003004572720100";
    let mut art: Sequence(text) = [header_hex + adt_hex];
    for f in fns {
        let mut err: text = "";
        (art, err) = encode_function(hx, u16, b_hex, f, art);
        if err != "" {
            return ([], err);
        }
    }
    return (art, "");
}
